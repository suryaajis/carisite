---
import { Icon } from 'astro-icon/components'
import { SITE } from '@/config/site'
---

<a
  href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Hubungi kami via WhatsApp"
  class="group fixed bottom-20 right-5 z-50 md:bottom-6 md:right-6"
>
  <span class="relative flex h-14 w-14 items-center justify-center">
    <span
      class="absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-60 animate-pulsering"
      aria-hidden="true"></span>
    <span
      class="relative inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-card transition-transform group-hover:scale-105"
    >
      <Icon name="lucide:message-circle" class="h-7 w-7" />
    </span>
  </span>
</a>
