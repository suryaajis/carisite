---
import { Icon } from 'astro-icon/components'
import { SITE } from '@/config/site'

const year = new Date().getFullYear()

const company = [
  { label: 'Tentang Kami', href: '/#advantages' },
  { label: 'Demo Website', href: '/#demo' },
  { label: 'Harga', href: '/#pricing' },
  { label: 'Artikel', href: '/articles' },
]
const help = [
  { label: 'FAQ', href: '/#faq' },
  { label: 'Order Website', href: '/#order' },
  { label: 'Kebijakan Privasi', href: '/#' },
  { label: 'Syarat & Ketentuan', href: '/#' },
]
---

<footer class="border-t border-outline-variant bg-surface-low">
  <div class="mx-auto max-w-container px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-3">
      <!-- Brand -->
      <div>
        <span class="font-heading text-2xl font-extrabold text-primary-deep">
          Cari<span class="text-primary">site</span>
        </span>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-muted">
          Solusi digital terbaik untuk membantu UMKM Indonesia naik kelas dengan
          website profesional.
        </p>
      </div>

      <!-- Nav -->
      <div class="grid grid-cols-2 gap-8">
        <div>
          <h3 class="text-sm font-semibold text-ink">Perusahaan</h3>
          <ul class="mt-4 space-y-2.5">
            {
              company.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-sm text-ink-muted transition-colors hover:text-primary-deep"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-ink">Bantuan</h3>
          <ul class="mt-4 space-y-2.5">
            {
              help.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-sm text-ink-muted transition-colors hover:text-primary-deep"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-semibold text-ink">Kontak</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href={`https://wa.me/${SITE.whatsapp}`}
              class="inline-flex items-center gap-2 text-sm text-ink-muted transition-colors hover:text-primary-deep"
            >
              <Icon name="lucide:message-circle" class="h-4 w-4 text-primary" />
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="inline-flex items-center gap-2 text-sm text-ink-muted transition-colors hover:text-primary-deep"
            >
              <Icon name="lucide:mail" class="h-4 w-4 text-primary" />
              {SITE.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 border-t border-outline-variant pt-6 text-center text-sm text-ink-muted"
    >
      © {year} {SITE.name} — Solusi Digital UMKM Indonesia
    </div>
  </div>
</footer>
