---
import { NAV_ITEMS } from '@/config/navigation'
const pathname = Astro.url.pathname
---
<header class="site-header">
  <nav class="wrap nav-inner" aria-label="Navigasi utama">
    <a class="wordmark" href="/" aria-label="Carisite — beranda">cari<span>site</span><i aria-hidden="true">✳</i></a>
    <ul class="desktop-nav">{NAV_ITEMS.map(item => <li><a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a></li>)}</ul>
    <a href="/kontak" class="button nav-cta">Mulai project <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" id="nav-toggle" aria-label="Buka menu" aria-controls="mobile-menu" aria-expanded="false">Menu <span aria-hidden="true">☰</span></button>
    <noscript><a href="/demo" class="mobile-fallback">Lihat demo ↗</a></noscript>
  </nav>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu navigasi">
  <div class="mobile-menu-top"><a class="wordmark" href="/">carisite<i aria-hidden="true">✳</i></a><button id="nav-close" aria-label="Tutup menu">Tutup ×</button></div>
  <nav aria-label="Navigasi seluler"><ul>{NAV_ITEMS.map((item, i) => <li><a href={item.href}><span class="menu-index">0{i + 1}</span>{item.label}<span aria-hidden="true">↗</span></a></li>)}</ul></nav>
  <a href="/kontak" class="button button-primary">Ceritakan ide Anda ↗</a>
  <p class="menu-note">Digital atelier untuk bisnis yang ingin melangkah lebih jauh.</p>
</dialog>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#nav-toggle')
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu')
  const close = document.querySelector<HTMLButtonElement>('#nav-close')
  let previousOverflow = ''
  toggle?.addEventListener('click', () => {
    if (!menu) return
    previousOverflow = document.body.style.overflow
    menu.showModal()
    toggle.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
    close?.focus()
  })
  const closeMenu = () => menu?.close()
  close?.addEventListener('click', closeMenu)
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu))
  menu?.addEventListener('click', event => { if (event.target === menu) closeMenu() })
  menu?.addEventListener('close', () => {
    document.body.style.overflow = previousOverflow
    toggle?.setAttribute('aria-expanded', 'false')
    toggle?.focus()
  })
  menu?.addEventListener('keydown', event => {
    if (event.key !== 'Tab') return
    const focusable = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button'))
    const first = focusable[0], last = focusable[focusable.length - 1]
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus() }
    if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus() }
  })
</script>
