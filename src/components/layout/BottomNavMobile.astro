---
import { Icon } from 'astro-icon/components'
import { SITE } from '@/config/site'
---

<nav
  class="fixed bottom-0 left-0 z-40 w-full border-t border-outline-variant bg-surface-lowest md:hidden"
  aria-label="Navigasi bawah"
>
  <div class="grid grid-cols-3">
    <button
      id="bottom-menu"
      class="flex flex-col items-center gap-1 py-2.5 text-xs font-medium text-ink-muted"
      aria-label="Buka menu"
    >
      <Icon name="lucide:menu" class="h-5 w-5" />
      Menu
    </button>
    <a
      href="/#faq"
      class="flex flex-col items-center gap-1 py-2.5 text-xs font-medium text-ink-muted"
    >
      <Icon name="lucide:help-circle" class="h-5 w-5" />
      Lainnya
    </a>
    <a
      href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center gap-1 py-2.5 text-xs font-semibold text-primary"
    >
      <Icon name="lucide:phone" class="h-5 w-5" />
      Hubungi
    </a>
  </div>
</nav>

<script>
  document.getElementById('bottom-menu')?.addEventListener('click', () => {
    ;(window as any).openNavDrawer?.()
  })
</script>
