---
const projects = [
  { slug: 'restoran', name: 'Rasa, cerita di setiap meja.', type: 'Food & beverage', image: 'restoran', tone: 'warm', number: '01' },
  { slug: 'properti', name: 'Ruang untuk hidup lebih baik.', type: 'Property & architecture', image: 'properti', tone: 'olive', number: '02' },
  { slug: 'dashboard', name: 'Data yang lebih mudah dipahami.', type: 'Dashboard & web app', image: 'dashboard', tone: 'mint', number: '03' },
]
---
<section id="karya" class="section work-section">
  <div class="wrap"><div class="section-top"><span class="eyebrow">01 / Selected explorations</span><span class="quiet-label">Konsep orisinal. Pengalaman nyata.</span></div><div class="section-heading"><h2 data-motion>Bukan sekadar terlihat.<br /><em>Terasa berbeda.</em></h2><div><p>Setiap bisnis punya cerita. Lihat bagaimana kami menerjemahkannya menjadi pengalaman digital yang punya karakter.</p><a class="text-link" href="/karya">Lihat semua eksplorasi <span aria-hidden="true">↗</span></a></div></div>
  <div class="work-grid">{projects.map(p => <a href={`/demo/${p.slug}`} class={`work-card ${p.tone}`} data-motion><div class="work-image"><span class="work-number">{p.number} / CONCEPT</span><div class="work-browser"><div class="work-browser-bar"><span>● ● ●</span><span>carisite.studio / {p.slug}</span></div><img src={`/images/previews/${p.image}-desktop.webp`} alt={`Tampilan konsep ${p.type}`} width="1440" height="1000" loading="lazy" /></div><span class="work-open" aria-label="Buka detail konsep">↗</span></div><div class="work-meta"><div><span class="eyebrow">{p.type}</span><h3>{p.name}</h3></div><span class="work-tag">Web design + development</span></div></a>)}</div>
  <p class="concept-note">Karya di atas adalah proyek konsep untuk menunjukkan pendekatan desain dan pengembangan kami.</p></div>
</section>
