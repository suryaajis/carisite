---
import { Icon } from 'astro-icon/components'
import Button from '@/components/ui/Button.astro'
import { SITE } from '@/config/site'
---

<section class="bg-surface pb-16 sm:pb-20">
  <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
    <div
      class="reveal overflow-hidden rounded-2xl bg-gradient-to-br from-primary-deep to-primary px-6 py-14 text-center text-white sm:px-12"
    >
      <h2 class="mx-auto max-w-2xl text-3xl font-extrabold leading-tight sm:text-4xl">
        Saatnya Bisnis Anda Tampil Lebih Profesional
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-white/90">
        Dapatkan website profesional yang meningkatkan kepercayaan dan
        memperluas jangkauan bisnis Anda.
      </p>
      <div class="mt-8 flex justify-center">
        <Button
          variant="primary"
          href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-green hover:bg-green/90 text-primary-deep"
        >
          <Icon name="lucide:message-circle" class="h-4 w-4" />
          Konsultasi Gratis Sekarang
        </Button>
      </div>
    </div>
  </div>
</section>
