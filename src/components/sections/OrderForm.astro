---
import { Icon } from 'astro-icon/components'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import { SITE } from '@/config/site'
---

<section id="order" class="bg-surface">
  <div class="mx-auto max-w-xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <SectionLabel label="Order" />
    <h2 class="reveal mt-4 text-center text-3xl font-extrabold text-ink sm:text-4xl">
      Pesan Website Anda Sekarang
    </h2>
    <p class="reveal mx-auto mt-3 max-w-md text-center text-ink-muted">
      Isi data berikut, dan pesanan Anda akan langsung diteruskan ke tim kami
      via WhatsApp.
    </p>

    <form
      id="order-form"
      data-wa={SITE.whatsapp}
      novalidate
      class="reveal mt-10 space-y-5 rounded-2xl border border-outline-variant bg-surface-lowest p-6 shadow-soft sm:p-8"
    >
      <div>
        <label for="name" class="block text-sm font-semibold text-ink">Nama Lengkap</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          class="mt-1.5 w-full rounded-xl border border-outline-variant bg-surface px-4 py-2.5 text-sm text-ink outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30"
          placeholder="cth. Budi Santoso"
        />
        <p data-error-for="name" class="mt-1 hidden text-xs text-red-500"></p>
      </div>

      <div>
        <label for="business" class="block text-sm font-semibold text-ink">Nama Bisnis</label>
        <input
          id="business"
          name="business"
          type="text"
          required
          class="mt-1.5 w-full rounded-xl border border-outline-variant bg-surface px-4 py-2.5 text-sm text-ink outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30"
          placeholder="cth. Laundry Bersih Wangi"
        />
        <p data-error-for="business" class="mt-1 hidden text-xs text-red-500"></p>
      </div>

      <div>
        <label for="domain" class="block text-sm font-semibold text-ink">Domain yang Diinginkan</label>
        <input
          id="domain"
          name="domain"
          type="text"
          required
          class="mt-1.5 w-full rounded-xl border border-outline-variant bg-surface px-4 py-2.5 text-sm text-ink outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30"
          placeholder="cth. bisnissaya.com"
        />
        <p data-error-for="domain" class="mt-1 hidden text-xs text-red-500"></p>
      </div>

      <button
        type="submit"
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-white shadow-soft transition hover:bg-primary-hover active:scale-[0.98]"
      >
        <Icon name="lucide:send" class="h-4 w-4" />
        Kirim Pesanan
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('order-form') as HTMLFormElement | null
  if (form) {
    const wa = form.dataset.wa ?? ''
    const fields = ['name', 'business', 'domain'] as const

    const setError = (field: string, message: string) => {
      const input = form.querySelector<HTMLInputElement>(`#${field}`)
      const err = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`)
      if (err) {
        err.textContent = message
        err.classList.toggle('hidden', !message)
      }
      input?.classList.toggle('border-red-400', Boolean(message))
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault()
      const data = new FormData(form)
      let valid = true

      for (const field of fields) {
        const value = String(data.get(field) ?? '').trim()
        if (!value) {
          setError(field, 'Wajib diisi')
          valid = false
        } else {
          setError(field, '')
        }
      }
      if (!valid) return

      const name = String(data.get('name')).trim()
      const business = String(data.get('business')).trim()
      const domain = String(data.get('domain')).trim()
      const msg = `Halo, saya ingin pesan website.\nNama: ${name}\nBisnis: ${business}\nDomain: ${domain}`
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(msg)}`, '_blank')
    })
  }
</script>
