  <div class="wrap hero-content">
    <div class="hero-topline"><span class="eyebrow"><span class="status-dot"></span> Independent digital atelier</span><span class="hero-location">Indonesia · Design & development</span></div>
    <div class="hero-title-row"><h1 id="hero-title" data-motion>Website yang<br />bikin bisnis<br /><span>naik kelas.</span></h1><div class="hero-aside"><span class="hero-symbol" aria-hidden="true">✳</span><p>Dari kesan pertama<br />ke langkah berikutnya.</p></div></div>
    <div class="hero-lower"><p>Strategi, desain, dan teknologi dalam satu tempat. Kami membantu bisnis Anda tampil berkarakter, mudah ditemukan, dan siap bertumbuh.</p><div class="hero-actions"><a class="button button-primary" href="/demo">Jelajahi demo <span aria-hidden="true">↗</span></a><a class="hero-text-link" href="/kontak">Diskusikan proyek <span aria-hidden="true">↗</span></a></div><a class="hero-scroll" href="#karya" aria-label="Lihat karya pilihan">Scroll to explore <span aria-hidden="true">↓</span></a></div>
    <div class="hero-showcase">
      <div class="showcase-caption"><span class="status-dot"></span> IDE → IDENTITAS → PENGALAMAN DIGITAL</div>
      <a href="/demo/properti" class="browser-window browser-back"><div class="browser-bar"><span>● ● ●</span><span>Ruang — property concept</span><span>↗</span></div><img src="/images/previews/properti-desktop.webp" srcset="/images/previews/properti-480.webp 480w, /images/previews/properti-960.webp 960w, /images/previews/properti-desktop.webp 1440w" sizes="(max-width:640px) 85vw, 60vw" width="1440" height="1000" alt="Pratinjau konsep website properti dengan desain editorial" loading="eager" /></a>
      <a href="/demo/restoran" class="browser-window browser-front" id="showreel-project"><div class="browser-bar"><span>● ● ●</span><span id="showreel-title">Rasa — restaurant concept</span><span>↗</span></div><img id="showreel-image" src="/images/previews/restoran-desktop.webp" srcset="/images/previews/restoran-480.webp 480w, /images/previews/restoran-960.webp 960w, /images/previews/restoran-desktop.webp 1440w" sizes="(max-width:640px) 85vw, 60vw" width="1440" height="1000" alt="Pratinjau konsep website restoran Rasa" loading="eager" fetchpriority="high" /></a>
      <div class="showcase-stamp"><span>DESIGNED<br />WITH PURPOSE</span><span aria-hidden="true">↗</span></div>
      <span class="showcase-footnote">Eksplorasi desain Carisite · Bukan proyek klien</span>
      <div class="showreel-controls" id="showreel-controls" hidden><button id="showreel-toggle" type="button" aria-pressed="false"><span aria-hidden="true">▶</span> Putar showreel</button><span id="showreel-count" aria-live="off">01 / 03</span><button id="showreel-next" type="button" aria-label="Tampilkan konsep berikutnya">→</button></div>
    </div>
  </div>
</section>
<script>
  import {animate} from 'motion'
  const frames = [
    { slug: 'restoran', title: 'Rasa — restaurant concept', alt: 'Pratinjau konsep website restoran Rasa' },
    { slug: 'properti', title: 'Ruang — property concept', alt: 'Pratinjau konsep website properti Ruang' },
    { slug: 'dashboard', title: 'Pulse — dashboard concept', alt: 'Pratinjau konsep dashboard analitik Pulse' },
  ]
  const play = document.querySelector<HTMLButtonElement>('#showreel-toggle')
  const next = document.querySelector<HTMLButtonElement>('#showreel-next')
  const image = document.querySelector<HTMLImageElement>('#showreel-image')
  const link = document.querySelector<HTMLAnchorElement>('#showreel-project')
  const title = document.querySelector('#showreel-title')
  const count = document.querySelector('#showreel-count')
  const controls = document.querySelector<HTMLElement>('#showreel-controls')
  let current = 0
  let timer: ReturnType<typeof setInterval> | undefined
  if (controls) controls.hidden = false
  function advance() {
    current = (current + 1) % frames.length
    const frame = frames[current]
    if (image) { if(!matchMedia('(prefers-reduced-motion: reduce)').matches)animate(image,{opacity:[.4,1]},{duration:.5}); image.srcset = '/images/previews/' + frame.slug + '-480.webp 480w, /images/previews/' + frame.slug + '-960.webp 960w, /images/previews/' + frame.slug + '-desktop.webp 1440w'; image.src = '/images/previews/' + frame.slug + '-desktop.webp'; image.alt = frame.alt }
    if (link) link.href = '/demo/' + frame.slug
    if (title) title.textContent = frame.title
    if (count) count.textContent = '0' + (current + 1) + ' / 03'
  }
  function pause() {
    clearInterval(timer); timer = undefined
    if (play) { play.innerHTML = '<span aria-hidden="true">▶</span> Putar showreel'; play.setAttribute('aria-pressed', 'false') }
  }
  play?.addEventListener('click', () => {
    if (timer) { pause(); return }
    advance()
    timer = setInterval(advance, 4500)
    play.innerHTML = '<span aria-hidden="true">Ⅱ</span> Jeda showreel'
    play.setAttribute('aria-pressed', 'true')
  })
  next?.addEventListener('click', () => { pause(); advance() })
  document.addEventListener('visibilitychange', () => { if (document.hidden) pause() })
  window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', pause)
  window.addEventListener('pagehide',pause,{once:true})
</script>
