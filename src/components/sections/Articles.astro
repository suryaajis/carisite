---
import { getCollection } from 'astro:content'
import SectionLabel from '@/components/ui/SectionLabel.astro'
import Badge from '@/components/ui/Badge.astro'
import Button from '@/components/ui/Button.astro'

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 4)
---

<section id="articles" class="bg-surface">
  <div class="mx-auto max-w-container px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <SectionLabel label="Artikel" />
    <h2 class="reveal mt-4 text-center text-3xl font-extrabold text-ink sm:text-4xl">
      Wawasan & Inspirasi Bisnis
    </h2>
    <p class="reveal mx-auto mt-3 max-w-2xl text-center text-ink-muted">
      Tips dan informasi praktis untuk membantu UMKM Anda tumbuh di era digital.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        articles.map((article) => (
          <article class="reveal group overflow-hidden rounded-xl border border-outline-variant bg-surface-lowest shadow-soft transition-shadow hover:shadow-card">
            <a href={`/articles/${article.slug}`} class="block overflow-hidden">
              <img
                src={article.data.image}
                alt={article.data.title}
                width="800"
                height="500"
                loading="lazy"
                class="aspect-[8/5] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </a>
            <div class="p-6">
              <Badge label={article.data.category} />
              <h3 class="mt-3 font-heading text-lg font-bold text-ink">
                <a href={`/articles/${article.slug}`} class="hover:text-primary-deep">
                  {article.data.title}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                {article.data.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-10 flex justify-center">
      <Button variant="outline" href="/articles">Lihat Semua Artikel</Button>
    </div>
  </div>
</section>
