---
import { getCollection } from 'astro:content'
const articles = (await getCollection('articles')).sort((a,b)=>b.data.publishDate.getTime()-a.data.publishDate.getTime()).slice(0,3)
---
<section id="articles" class="section journal-section"><div class="wrap"><div class="section-top"><span class="eyebrow">05 / Notes from the atelier</span><a href="/articles" class="text-link">Semua jurnal ↗</a></div><div class="section-heading"><h2 data-motion>Ide untuk<br /><em>langkah berikutnya.</em></h2><p>Catatan seputar website, identitas digital, dan cara bisnis menemukan tempatnya di internet.</p></div><div class="journal-grid">{articles.map(article => <article class="journal-card" data-motion><a href={`/articles/${article.slug}`}><div class="journal-image"><img src={article.data.image} width="800" height="500" loading="lazy" alt={article.data.title} /><span aria-hidden="true">↗</span></div><div class="journal-meta"><span class="eyebrow">{article.data.category}</span><time datetime={article.data.publishDate.toISOString()}>{article.data.publishDate.toLocaleDateString('id-ID',{month:'short',year:'numeric'})}</time></div><h3>{article.data.title}</h3><p>{article.data.description}</p></a></article>)}</div></div></section>
