---
import {getCollection} from 'astro:content'
import {SITE,waLink} from '@/config/site'
import {packages} from '@/data/services'
const demos=(await getCollection('demo')).sort((a,b)=>a.data.order-b.data.order)
const features=['Katalog produk','Form / reservasi','Keranjang belanja','Dashboard','Artikel / berita','Integrasi API','Redesign','Belum yakin']
---
<form id="brief-form" data-wa={SITE.whatsapp} novalidate>
<div class="brief-heading"><span>01 — Ceritakan kebutuhan</span><p>Tidak perlu brief yang sempurna. Mulai dari yang sudah Anda tahu.</p></div>
<div class="brief-grid"><div class="brief-field"><label for="brief-name">Nama Anda <span>*</span></label><input id="brief-name" name="name" autocomplete="name" required maxlength="100" placeholder="Nama lengkap" aria-describedby="name-error"/><span class="field-error" id="name-error"></span></div><div class="brief-field"><label for="brief-business">Nama bisnis <span>*</span></label><input id="brief-business" name="business" autocomplete="organization" required maxlength="120" placeholder="Nama bisnis / organisasi" aria-describedby="business-error"/><span class="field-error" id="business-error"></span></div><div class="brief-field"><label for="brief-type">Jenis website <span>*</span></label><select id="brief-type" name="type" required aria-describedby="type-error"><option value="">Pilih kebutuhan</option>{['Landing page','Company profile','Katalog / e-commerce','Booking / reservasi','Dashboard / aplikasi web','Redesign','Belum yakin'].map(x=><option>{x}</option>)}</select><span class="field-error" id="type-error"></span></div><div class="brief-field"><label for="brief-package">Acuan paket</label><select id="brief-package" name="package"><option value="">Diskusikan dahulu</option>{packages.map(p=><option value={p.id}>{p.name} — {p.label}</option>)}</select></div></div>
<fieldset class="brief-features"><legend>Fitur yang Anda bayangkan</legend><div>{features.map(f=><label><input type="checkbox" name="features" value={f}/><span>{f}</span></label>)}</div></fieldset>
<div class="brief-grid"><div class="brief-field"><label for="brief-budget">Kisaran budget (opsional)</label><select id="brief-budget" name="budget"><option value="">Belum ditentukan</option><option>Di bawah Rp2 juta</option><option>Rp2–5 juta</option><option>Rp5–15 juta</option><option>Di atas Rp15 juta</option></select></div><div class="brief-field"><label for="brief-time">Target waktu (opsional)</label><input id="brief-time" name="time" maxlength="100" placeholder="Misalnya: ingin tayang bulan depan"/></div><div class="brief-field brief-wide"><label for="brief-demo">Demo referensi</label><select id="brief-demo" name="demo"><option value="">Belum memilih</option>{demos.map(d=><option value={d.id}>{d.data.title} — {d.data.category}</option>)}</select></div><div class="brief-field brief-wide"><label for="brief-notes">Apa yang ingin dicapai?</label><textarea id="brief-notes" name="notes" rows="4" maxlength="2000" placeholder="Ceritakan bisnis, tantangan, atau ide Anda…"></textarea></div></div>
<p class="brief-explainer">Form ini menyiapkan pesan WhatsApp. Data belum dikirim dan tidak disimpan di server Carisite. Anda dapat memeriksanya sebelum membuka WhatsApp.</p><button type="submit" class="button button-primary">Periksa ringkasan brief ↗</button><noscript><p>Untuk konsultasi tanpa JavaScript, <a href={waLink()}>buka WhatsApp Carisite</a>.</p></noscript>
<section id="brief-summary" class="brief-summary" hidden tabindex="-1" aria-labelledby="summary-title"><span>02 — Periksa sebelum melanjutkan</span><h2 id="summary-title">Brief Anda sudah tersusun.</h2><pre id="brief-message"></pre><p>Paket adalah acuan awal. Lingkup, integrasi, durasi hosting/domain, perpanjangan, revisi, dan jadwal akan dikonfirmasi dalam penawaran.</p><a id="brief-whatsapp" class="button button-primary" href={waLink()} target="_blank" rel="noopener noreferrer">Buka WhatsApp dengan brief →</a><p class="brief-disclaimer">Anda masih perlu menekan kirim di WhatsApp.</p></section>
</form>
<style>
#brief-form{max-width:860px;margin:0 auto}.brief-heading{border-bottom:1px solid var(--line);padding-bottom:1.5rem;margin-bottom:2rem}.brief-heading>span,.brief-summary>span{font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}.brief-heading p{margin-top:.8rem;color:var(--muted);font-size:.9rem}.brief-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}.brief-field{display:flex;flex-direction:column;gap:.6rem}.brief-field label,.brief-features legend{font-size:.8rem;font-weight:600}.brief-field label>span{color:#8a3429}.brief-field input,.brief-field select,.brief-field textarea{width:100%;padding:1rem;background:#fff;border:1px solid var(--line,#cdd6c8);border-radius:6px;font:inherit;font-size:.9rem;color:var(--ink);min-height:50px}.brief-field textarea{resize:vertical}.brief-field [aria-invalid=true]{border-color:#a73d30}.field-error{font-size:.75rem;color:#92352b;min-height:.8rem}.brief-wide{grid-column:1/-1}.brief-features{border:0;padding:0;margin:1.8rem 0 2rem}.brief-features>div{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}.brief-features label{display:flex;align-items:center;gap:.6rem;border:1px solid var(--line);border-radius:5px;padding:.8rem;font-size:.8rem;cursor:pointer}.brief-features label:has(input:checked){background:#e2efcb;border-color:#6b823a}.brief-features input{width:16px;height:16px;accent-color:#164431}.brief-explainer{font-size:.8rem;line-height:1.7;color:var(--muted);margin:1.5rem 0}.brief-summary{background:#e6eddc;padding:2rem;margin-top:2rem;border-radius:8px}.brief-summary h2{font-size:1.8rem;letter-spacing:-.04em;margin:1rem 0}.brief-summary pre{font:inherit;font-size:.85rem;white-space:pre-wrap;overflow-wrap:anywhere;background:#f6f8f0;padding:1.5rem;line-height:1.8;border-radius:5px}.brief-summary p{font-size:.8rem;line-height:1.7;margin:1.2rem 0}.brief-disclaimer{color:var(--muted)}@media(max-width:600px){.brief-grid{grid-template-columns:1fr}.brief-summary{padding:1.2rem}.brief-summary pre{padding:1rem}.brief-features label{font-size:.75rem;padding:.7rem}}
</style>
<script>
const form=document.querySelector<HTMLFormElement>('#brief-form');if(form){
const params=new URLSearchParams(location.search);for(const [param,name] of [['demo','demo'],['paket','package'],['package','package'],['type','type']]){const select=form.elements.namedItem(name) as HTMLSelectElement;const value=params.get(param);if(value&&[...select.options].some(o=>o.value===value))select.value=value}
const summary=form.querySelector<HTMLElement>('#brief-summary')!;const required=['name','business','type'];const validate=(name:string)=>{const input=form.elements.namedItem(name) as HTMLInputElement|HTMLSelectElement;const valid=Boolean(input.value.trim());input.setAttribute('aria-invalid',String(!valid));form.querySelector(`#${name}-error`)!.textContent=valid?'':'Mohon isi bagian ini.';return valid}
form.addEventListener('input',()=>{summary.hidden=true});form.addEventListener('change',()=>{summary.hidden=true});required.forEach(name=>(form.elements.namedItem(name) as HTMLElement).addEventListener('blur',()=>validate(name)))
form.addEventListener('submit',event=>{event.preventDefault();const invalid=required.filter(name=>!validate(name));if(invalid.length){(form.elements.namedItem(invalid[0]) as HTMLElement).focus();return}const data=new FormData(form);const selected=(name:string)=>{const s=form.elements.namedItem(name) as HTMLSelectElement;return s.value?s.selectedOptions[0].textContent:'Belum ditentukan'};const msg=`Halo Carisite, saya ingin mendiskusikan proyek website.\n\nNama: ${String(data.get('name')).trim()}\nBisnis: ${String(data.get('business')).trim()}\nJenis: ${data.get('type')}\nPaket acuan: ${selected('package')}\nFitur: ${data.getAll('features').join(', ')||'Perlu rekomendasi'}\nBudget: ${data.get('budget')||'Belum ditentukan'}\nTarget waktu: ${String(data.get('time')).trim()||'Fleksibel'}\nDemo referensi: ${selected('demo')}\nCatatan: ${String(data.get('notes')).trim()||'—'}`;form.querySelector('#brief-message')!.textContent=msg;(form.querySelector('#brief-whatsapp') as HTMLAnchorElement).href=`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(msg)}`;summary.hidden=false;summary.focus();summary.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'nearest'})})
}
</script>
