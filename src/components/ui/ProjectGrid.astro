---
import {getCollection} from 'astro:content'
interface Props {filterable?:boolean;limit?:number;cases?:boolean}
const {filterable=false,limit,cases=false}=Astro.props
const projects=(await getCollection('demo')).sort((a,b)=>a.data.order-b.data.order).slice(0,limit)
const categories=[...new Set(projects.map(p=>p.data.category))]
---
<div class="project-catalog">
{filterable && <div class="catalog-tools"><label class="search-label">Cari inspirasi<input type="search" placeholder="Nama, industri, atau fitur…" data-project-search/></label><div class="filter-list" role="group" aria-label="Kategori demo"><button type="button" data-project-filter="all" aria-pressed="true">Semua ({projects.length})</button>{categories.map(cat=><button type="button" data-project-filter={cat} aria-pressed="false">{cat}</button>)}</div><p aria-live="polite" data-project-count>{projects.length} konsep untuk dijelajahi</p></div>}
<div class="project-grid">{projects.map((p,i)=><article class="project-card" data-project-card data-category={p.data.category} data-search={`${p.data.title} ${p.data.category} ${p.data.features?.join(' ')}`.toLocaleLowerCase('id-ID')}><a class="project-image" href={cases?`/karya/${p.id}`:`/demo/preview/${p.id}`} style={`--accent:${p.data.accent}`} aria-label={`Jelajahi ${p.data.title}`}><div class="browser-bar">● ● ● <span>{p.id}.demo</span></div><img src={p.data.image} alt={`Tampilan desktop ${p.data.title}`} width="1440" height="1000" loading="lazy"/><span class="project-open">{cases?'Lihat konsep':'Jelajahi demo'} ↗</span></a><div class="project-meta"><span>{String(i+1).padStart(2,'0')} / {p.data.category}</span><span>{p.data.status}</span></div><h2><a href={cases?`/karya/${p.id}`:`/demo/${p.id}`}>{p.data.title}</a></h2><p>{p.data.description}</p><div class="project-links"><a href={`/demo/preview/${p.id}`}>Coba live demo ↗</a><a href={`/karya/${p.id}`}>Studi konsep →</a></div></article>)}</div>
{filterable && <div class="catalog-empty" hidden data-project-empty><h2>Belum ada yang cocok.</h2><p>Coba kata kunci lain atau tampilkan semua kategori.</p><button type="button" class="button button-secondary" data-project-reset>Reset pencarian</button></div>}
</div>
<style>
.catalog-tools{margin-bottom:3rem}.search-label{display:grid;gap:.65rem;font-size:.8rem;font-weight:600;max-width:34rem}.search-label input{background:white;border:1px solid var(--line,#d4dad2);border-radius:8px;padding:1rem;font:inherit;font-size:1rem;width:100%}.filter-list{display:flex;gap:.5rem;flex-wrap:wrap;margin:1.5rem 0}.filter-list button{border:1px solid var(--line);padding:.65rem 1rem;border-radius:99px;font-size:.78rem}.filter-list button[aria-pressed=true]{background:var(--forest);color:white}.catalog-tools>p{font-size:.8rem;color:var(--muted)}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3.5rem 2rem}.project-card[hidden]{display:none}.project-image{display:block;position:relative;background:var(--accent);padding:2rem 2rem 0;border-radius:4px;overflow:hidden}.browser-bar{background:#f7f7f4;font-size:.6rem;padding:.65rem .9rem;border-radius:7px 7px 0 0;color:#65716b;letter-spacing:.15em}.browser-bar span{margin-left:1.5rem;letter-spacing:0}.project-image img{width:100%;aspect-ratio:1.6;object-fit:cover;object-position:top;transition:transform .55s;display:block}.project-image:hover img{transform:translateY(-4px)}.project-open{position:absolute;bottom:1rem;right:1rem;background:var(--lime);color:#132c25;padding:.65rem 1rem;border-radius:99px;font-size:.75rem;font-weight:600}.project-meta{display:flex;justify-content:space-between;gap:1rem;font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;margin:1.2rem 0 .6rem;color:var(--muted)}.project-card h2{font-size:clamp(1.3rem,2.5vw,1.8rem);margin:0 0 .6rem;letter-spacing:-.04em}.project-card p{font-size:.9rem;line-height:1.7;color:var(--muted);max-width:36rem}.project-links{display:flex;gap:1.5rem;margin-top:1rem;font-size:.78rem;font-weight:600}.project-links a{border-bottom:1px solid var(--line);padding-bottom:.25rem}.catalog-empty{padding:4rem;text-align:center;border:1px solid var(--line)}.catalog-empty h2{font-size:2rem}.catalog-empty p{margin:1rem 0 2rem}@media(max-width:650px){.project-grid{grid-template-columns:1fr;gap:2.5rem}.project-image{padding:1.3rem 1.3rem 0}.project-meta{font-size:.6rem}.filter-list{gap:.4rem}.filter-list button{padding:.6rem .8rem}}
</style>
<script>
import {animate} from 'motion'
document.querySelectorAll<HTMLElement>('.project-catalog').forEach(catalog=>{
const input=catalog.querySelector<HTMLInputElement>('[data-project-search]');if(!input)return
const buttons=[...catalog.querySelectorAll<HTMLButtonElement>('[data-project-filter]')];const cards=[...catalog.querySelectorAll<HTMLElement>('[data-project-card]')];let category='all'
const update=()=>{const query=input.value.trim().toLocaleLowerCase('id-ID');let count=0;cards.forEach(card=>{const show=(category==='all'||card.dataset.category===category)&&(card.dataset.search??'').includes(query);card.hidden=!show;if(show){count++;if(!matchMedia('(prefers-reduced-motion: reduce)').matches)animate(card,{opacity:[.5,1],y:[8,0]},{duration:.25})}});const label=catalog.querySelector('[data-project-count]');if(label)label.textContent=`${count} konsep ditemukan`;const empty=catalog.querySelector<HTMLElement>('[data-project-empty]');if(empty)empty.hidden=count>0;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.projectFilter===category)))}
input.addEventListener('input',update);buttons.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.projectFilter??'all';update()}));catalog.querySelector('[data-project-reset]')?.addEventListener('click',()=>{input.value='';category='all';update();input.focus()})
})
</script>
