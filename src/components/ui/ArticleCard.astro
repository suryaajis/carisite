---
import type {CollectionEntry} from 'astro:content'
interface Props{entry:CollectionEntry<'articles'>}
const {entry:a}=Astro.props
---
<article class="insight-card" data-article-category={a.data.category}><a href={`/articles/${a.slug}`} class="insight-image"><img src={a.data.image} alt={`Ilustrasi ${a.data.title}`} width="800" height="500" loading="lazy"/><span aria-hidden="true">↗</span></a><div class="insight-meta"><span>{a.data.category}</span><time datetime={a.data.publishDate.toISOString()}>{a.data.publishDate.toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'})}</time></div><h2><a href={`/articles/${a.slug}`}>{a.data.title}</a></h2><p>{a.data.description}</p><a class="insight-read" href={`/articles/${a.slug}`}>Baca artikel →</a></article>
<style>.insight-image{display:block;position:relative;overflow:hidden;border-radius:5px;background:#e1e7d9}.insight-image img{width:100%;aspect-ratio:1.6;object-fit:cover;transition:transform .4s}.insight-image:hover img{transform:scale(1.025)}.insight-image>span{position:absolute;right:1rem;bottom:1rem;border-radius:50%;background:var(--lime);width:38px;height:38px;display:grid;place-items:center}.insight-meta{display:flex;justify-content:space-between;gap:1rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-size:.65rem;margin:1.3rem 0}.insight-card h2{font-size:clamp(1.4rem,2.4vw,2rem);line-height:1.3;letter-spacing:-.04em}.insight-card p{font-size:.9rem;line-height:1.8;color:var(--muted);margin:1rem 0}.insight-read{font-size:.8rem;font-weight:600;border-bottom:1px solid var(--line);padding-bottom:.4rem}</style>
