<script>
import {animate,inView} from 'motion'
if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
 const stop=inView('[data-motion]',element=>{const control=animate(element,{opacity:[.6,1],y:[20,0]},{duration:.65,ease:[.2,.7,.3,1]});return()=>control.stop()},{amount:.12})
 const fine=matchMedia('(pointer:fine)').matches
 if(fine)document.querySelectorAll<HTMLElement>('.nav-cta,.cta-bottom .button').forEach(button=>{button.addEventListener('pointermove',e=>{const rect=button.getBoundingClientRect();animate(button,{x:(e.clientX-rect.left-rect.width/2)*.08,y:(e.clientY-rect.top-rect.height/2)*.1},{duration:.2})});button.addEventListener('pointerleave',()=>animate(button,{x:0,y:0},{duration:.3}))})
 window.addEventListener('pagehide',stop,{once:true})
}
</script>
