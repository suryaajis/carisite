<DemoLayout title="COMMON — Good things, every day" slug="ecommerce" description="Demo toko fashion dengan katalog produk, pilihan varian, keranjang belanja, dan checkout simulasi.">
 <div class="common"><div class="announcement">A little less, a little better. <span>Free shipping untuk pesanan di atas Rp 750.000 ↗</span></div><header class="shop-nav"><a class="wordmark" href="#demo-main">COMMON<span>®</span></a><nav aria-label="Navigasi Common"><a href="#collection">Shop all</a><a href="#collection" data-nav-category="Clothing">Clothing</a><a href="#collection" data-nav-category="Accessories">Accessories</a><a href="#values">Our approach</a></nav><button id="open-cart" class="cart-trigger" aria-label="Buka keranjang belanja">Bag <span id="cart-count">0</span></button></header><div>
 <section class="shop-hero"><div class="hero-copy"><p class="eyebrow">THE EVERYDAY COLLECTION / 2026</p><h1>Less fuss.<br/>More <em>living.</em></h1><p>Barang baik untuk hari-hari biasa.<br/>Dibuat dengan perhatian, dipakai tanpa berpikir dua kali.</p><a href="#collection" class="dark-button">Explore the collection <span>↗</span></a><span class="small-note">GOOD THINGS. EVERY DAY.</span></div><div class="hero-image"><img src="/images/demo-assets/photo-1483985988355-763728e1935b.webp" alt="Gaya berpakaian sehari-hari dengan warna hangat dan natural" fetchpriority="high"/><div class="image-label"><span>Wear it your way.</span><b>01 — THE DAILY EDIT</b></div><span class="sticker">MADE FOR<br/><b>REAL LIFE.</b><br/>✳</span></div></section>
 <div class="value-strip"><span>Thoughtfully designed</span><i>✳</i><span>Made to stay</span><i>✳</i><span>Always in good company</span><i>✳</i><span>Everyday, elevated</span></div>
 <section id="collection" class="catalog container"><div class="catalog-heading"><div><p class="eyebrow">YOUR NEW EVERYDAY FAVORITES</p><h2>Meet the essentials.</h2></div><label class="sort-label">Sort by <select id="product-sort" aria-label="Urutkan produk"><option value="featured">Featured</option><option value="low">Harga terendah</option><option value="high">Harga tertinggi</option></select></label></div><div class="category-row"><div role="group" aria-label="Filter kategori">{['All things','Clothing','Accessories','Footwear'].map((category,index)=><button class:list={['category',{'active':index===0}]} data-category={index===0?'all':category} aria-pressed={index===0?'true':'false'}>{category}</button>)}</div><p id="product-count" aria-live="polite">6 good things</p></div><div class="product-grid">{products.map((product,index)=><article class="product" data-category={product.category} data-price={product.price} data-index={index}><button class="product-image" data-product={index} aria-label={`Lihat ${product.name}`}><img src={`/images/demo-assets/${product.img}.webp`} alt={product.name} loading="lazy"/>{product.tag&&<span class="product-tag">{product.tag}</span>}<span class="quick-add">Choose your size <b>+</b></span></button><div class="product-title"><h3><button data-product={index}>{product.name}</button></h3><span>Rp {new Intl.NumberFormat('id-ID').format(product.price)}</span></div><p>{product.note}</p><div class="swatches" role="img" aria-label="Warna tersedia: Natural dan Ink"><span></span><span></span></div></article>)}</div></section>
 <section id="values" class="brand-story"><div class="story-image"><img src="/images/demo-assets/photo-1441986300917-64674bd600d8.webp" alt="Koleksi pakaian yang ditata rapi di studio Common" loading="lazy"/></div><div class="story-copy"><p class="eyebrow">FEWER THINGS. BETTER STORIES.</p><h2>Not just for a season.<br/><em>For your every day.</em></h2><p>Kami menyukai desain sederhana, bahan yang terasa baik, dan barang yang semakin akrab seiring waktu. Tidak berlebihan. Cukup yang benar-benar Anda butuhkan.</p><div class="story-features"><div><b>01 / CONSIDERED</b><p>Setiap detail punya alasan.</p></div><div><b>02 / LONG-LOVED</b><p>Dibuat untuk dipakai berulang.</p></div></div><a href="#collection">Find your everyday favorite ↗</a></div></section>
 <section class="service container"><div><span>↗</span><h3>A smooth delivery</h3><p>Gratis ongkir mulai Rp 750.000.</p></div><div><span>↔</span><h3>Room to change your mind</h3><p>Contoh kebijakan tukar 14 hari.</p></div><div><span>♡</span><h3>A little more personal</h3><p>Dipilih dengan hati, untuk hari Anda.</p></div></section>
 </div><footer><div class="container footer-top"><a class="wordmark" href="#demo-main">COMMON<span>®</span></a><p>Good things,<br/><em>in good company.</em></p><a href="#collection">Back to the good stuff ↑</a></div><div class="container footer-bottom"><span>© 2026 COMMON. A Carisite demo store.</span><span>Produk contoh · Tidak ada transaksi nyata</span></div></footer>
 <dialog id="product-dialog" aria-labelledby="detail-title"><button class="close" aria-label="Tutup detail produk">×</button><div class="detail-grid"><img id="detail-image" src="/images/demo-assets/photo-1596755094514-f87e34085b2c.webp" alt="Pratinjau produk"/><div class="detail-copy"><p class="eyebrow">YOUR NEXT EVERYDAY FAVORITE</p><h2 id="detail-title"></h2><p id="detail-note"></p><strong id="detail-price"></strong><form id="add-form"><label for="product-size">Size</label><select id="product-size" required></select><label for="product-color">Color</label><select id="product-color"><option>Natural</option><option>Ink</option></select><p class="detail-info">Pilih varian untuk simulasi. Foto menunjukkan inspirasi produk; warna pilihan tidak mengubah foto.</p><button type="submit" class="dark-button">Add to bag <span>+</span></button></form><p id="added-status" role="status"></p></div></div></dialog>
 <dialog id="cart-dialog" aria-labelledby="bag-title"><button class="close" aria-label="Tutup keranjang">×</button><p class="eyebrow">SOME GOOD CHOICES</p><h2 id="bag-title">Your bag.</h2><div id="cart-items"></div><div id="cart-summary"></div><button id="checkout-button" class="dark-button" disabled>Simulate checkout <span>↗</span></button><p class="cart-note">Toko demo. Tidak ada pembayaran atau pengiriman nyata.</p><p id="checkout-result" role="status"></p></dialog>
 </div>
 <script define:vars={{products}}>
 const money=v=>'Rp '+new Intl.NumberFormat('id-ID').format(v);let category='all',activeProduct=0;const cart=[];const detail=document.querySelector('#product-dialog'),bag=document.querySelector('#cart-dialog');
 function applyFilter(){let count=0;document.querySelectorAll('.product').forEach(card=>{card.hidden=category!=='all'&&card.dataset.category!==category;if(!card.hidden)count++});document.querySelector('#product-count').textContent=count+' good things';document.querySelectorAll('.category').forEach(button=>{const active=button.dataset.category===category;button.classList.toggle('active',active);button.setAttribute('aria-pressed',String(active))})}
 document.querySelectorAll('.category').forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category;applyFilter()}));document.querySelectorAll('[data-nav-category]').forEach(b=>b.addEventListener('click',()=>{category=b.dataset.navCategory;applyFilter()}));document.querySelector('#product-sort').addEventListener('change',e=>{const cards=[...document.querySelectorAll('.product')];cards.sort((a,b)=>e.target.value==='low'?Number(a.dataset.price)-Number(b.dataset.price):e.target.value==='high'?Number(b.dataset.price)-Number(a.dataset.price):Number(a.dataset.index)-Number(b.dataset.index));cards.forEach(card=>document.querySelector('.product-grid').append(card))});
 document.querySelectorAll('[data-product]').forEach(b=>b.addEventListener('click',()=>{activeProduct=Number(b.dataset.product);const product=products[activeProduct];document.querySelector('#detail-title').textContent=product.name;document.querySelector('#detail-note').textContent=product.note;document.querySelector('#detail-price').textContent=money(product.price);const photo=document.querySelector('#detail-image');photo.src='/images/demo-assets/'+product.img+'.webp';photo.alt=product.name;const size=document.querySelector('#product-size');size.replaceChildren(...product.sizes.map(s=>{const option=document.createElement('option');option.value=s;option.textContent=s;return option}));document.querySelector('#product-color').value='Natural';document.querySelector('#added-status').textContent='';detail.showModal()}));
 function renderCart(){const target=document.querySelector('#cart-items');target.replaceChildren();document.querySelector('#cart-count').textContent=String(cart.reduce((total,item)=>total+item.qty,0));if(!cart.length){const empty=document.createElement('p');empty.className='empty-cart';empty.textContent='Your bag is waiting for something good. Pilih produk dari koleksi kami.';target.append(empty)}cart.forEach((item,index)=>{const p=products[item.product];const row=document.createElement('div');row.className='cart-row';const photo=document.createElement('img');photo.src='/images/demo-assets/'+p.img+'.webp';photo.alt=p.name;const info=document.createElement('div');const title=document.createElement('strong');title.textContent=p.name;const meta=document.createElement('small');meta.textContent=item.size+' / '+item.color+' · '+money(p.price);const controls=document.createElement('div');controls.className='quantity';const minus=document.createElement('button');minus.textContent='−';minus.setAttribute('aria-label','Kurangi jumlah '+p.name);minus.addEventListener('click',()=>{item.qty--;if(item.qty===0)cart.splice(index,1);renderCart()});const count=document.createElement('span');count.textContent=String(item.qty);const plus=document.createElement('button');plus.textContent='+';plus.setAttribute('aria-label','Tambah jumlah '+p.name);plus.disabled=item.qty>=10;plus.addEventListener('click',()=>{item.qty++;renderCart()});const remove=document.createElement('button');remove.className='remove';remove.textContent='Remove';remove.setAttribute('aria-label','Hapus '+p.name);remove.addEventListener('click',()=>{cart.splice(index,1);renderCart()});controls.append(minus,count,plus,remove);info.append(title,meta,controls);row.append(photo,info);target.append(row)});const subtotal=cart.reduce((sum,item)=>sum+products[item.product].price*item.qty,0),shipping=subtotal===0||subtotal>=750000?0:25000;document.querySelector('#cart-summary').textContent=cart.length?'Subtotal '+money(subtotal)+' · Ongkir '+(shipping?money(shipping):'Gratis')+' · Total '+money(subtotal+shipping):'';document.querySelector('#checkout-button').disabled=!cart.length;document.querySelector('#checkout-result').textContent='';}
 document.querySelector('#add-form').addEventListener('submit',e=>{e.preventDefault();const size=document.querySelector('#product-size').value,color=document.querySelector('#product-color').value;const item=cart.find(i=>i.product===activeProduct&&i.size===size&&i.color===color);if(item&&item.qty>=10){document.querySelector('#added-status').textContent='Maksimal 10 item per varian untuk demo ini.';return}if(item)item.qty++;else cart.push({product:activeProduct,size,color,qty:1});renderCart();document.querySelector('#added-status').textContent='✓ Added to your bag. '+size+' / '+color+'.';});document.querySelector('#open-cart').addEventListener('click',()=>{renderCart();bag.showModal()});[detail,bag].forEach(dialog=>{dialog.querySelector('.close').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()})});document.querySelector('#checkout-button').addEventListener('click',()=>{cart.length=0;renderCart();document.querySelector('#checkout-result').textContent='✓ Checkout demo berhasil. Tidak ada biaya yang dikenakan dan tidak ada pesanan nyata. Terima kasih sudah mencoba COMMON.'});
 </script>
