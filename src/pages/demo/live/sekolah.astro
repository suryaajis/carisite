---
import DemoLayout from '@/layouts/DemoLayout.astro'
const programs = [
 {id:'sains',name:'Sains & eksplorasi',tag:'UNTUK PIKIRAN YANG INGIN TAHU',title:'Pertanyaan kecil. Penemuan besar.',description:'Belajar mengamati, mencoba, dan menemukan jawaban melalui proyek sains yang dekat dengan kehidupan sehari-hari.',activities:['Eksperimen sederhana & jurnal observasi','Proyek lingkungan dan kebun sekolah','Klub logika & pemecahan masalah'],image:'photo-1532094349884-543bc11b234d',alt:'Kegiatan eksplorasi sains di laboratorium',color:'#dce7fc'},
 {id:'seni',name:'Seni & ekspresi',tag:'UNTUK IMAJINASI TANPA BATAS',title:'Setiap anak punya cara bercerita.',description:'Ruang untuk mengekspresikan ide melalui warna, musik, gerak, dan karya. Proses kreatif sama berharganya dengan hasil akhir.',activities:['Studio gambar dan eksplorasi material','Musik, gerak, dan panggung ekspresi','Pameran karya dan cerita di baliknya'],image:'photo-1513364776144-60967b0f800f',alt:'Alat lukis dan warna untuk kegiatan seni',color:'#fbe2d6'},
 {id:'bahasa',name:'Bahasa & literasi',tag:'UNTUK SUARA YANG PERCAYA DIRI',title:'Membaca dunia. Menulis cerita.',description:'Membangun kebiasaan membaca, kemampuan mendengar, dan keberanian menyampaikan gagasan melalui aktivitas yang menyenangkan.',activities:['Lingkar baca dan diskusi buku','Bercerita dalam bahasa Indonesia & Inggris','Jurnal kreatif dan presentasi proyek'],image:'photo-1503676260728-1c00da094a0b',alt:'Buku dan alat tulis untuk kegiatan literasi',color:'#e9e1f6'},
]
---
<DemoLayout title="Harapan Bangsa — Grow with curiosity" slug="sekolah" description="Demo sekolah dengan eksplorasi program belajar dan simulasi pendaftaran kunjungan.">
 <div class="school">
  <header class="school-nav d-container"><a href="#demo-main" class="school-brand"><span class="brand-symbol" aria-hidden="true">✳</span><span>harapan<br /><b>bangsa.</b></span></a><nav aria-label="Navigasi sekolah"><a href="#tentang">Tentang kami</a><a href="#program">Program belajar</a><a class="d-button" href="#kunjungan">Kenali sekolah ↗</a></nav></header>
  <section class="school-hero d-container"><div><p class="d-kicker"><span class="small-spark">✦</span> TEMPAT RASA INGIN TAHU BERTUMBUH</p><h1>Langkah kecil.<br />Kemungkinan<br /><span>tak terbatas.</span></h1><p class="hero-lead">Setiap anak membawa dunianya sendiri. Kami hadir untuk membantu mereka menjelajahinya dengan berani.</p><div class="hero-actions"><a class="d-button" href="#program">Jelajahi program <span>↗</span></a><a class="secondary-link" href="#kunjungan">Coba kunjungan sekolah ↓</a></div><p class="hero-note">KONSEP SEKOLAH · DEMO INTERAKTIF CARISITE</p></div><div class="school-visual"><div class="circle-decoration"></div><img src="/images/demo-assets/photo-1503676260728-1c00da094a0b.webp" data-fallback="/images/demo/sekolah.svg" alt="Buku, alat tulis, dan apel di meja kelas" width="900" height="1050" fetchpriority="high" /><div class="floating-note"><span>✦</span><p>Be curious.<br /><b>Be yourself.</b></p></div><span class="image-spark" aria-hidden="true">✳</span></div></section>
  <div class="school-band"><span>RASA INGIN TAHU</span><i>✦</i><span>KEBERANIAN MENCOBA</span><i>✦</i><span>KEBAIKAN HATI</span><i>✦</i><span>RUANG BERTUMBUH</span></div>
  <section id="tentang" class="d-container d-section school-values"><div><p class="d-kicker">PENDIDIKAN YANG MELIHAT ANAK SEUTUHNYA</p><h2>Bukan sekadar belajar.<br /><span>Menemukan diri.</span></h2><p>Lingkungan yang hangat untuk belajar bertanya, berteman, dan berani mencoba hal baru. Konsep pendidikan yang menempatkan anak sebagai penjelajah aktif.</p></div><div class="value-grid"><article><span>01 / MIND</span><h3>Pikiran terbuka</h3><p>Belajar dari pertanyaan dan pengalaman langsung.</p></article><article><span>02 / HEART</span><h3>Hati yang peduli</h3><p>Membangun empati melalui kebersamaan sehari-hari.</p></article><article><span>03 / VOICE</span><h3>Suara yang berani</h3><p>Ruang aman untuk berbagi ide dan menjadi diri sendiri.</p></article></div></section>
  <section id="program" class="program-section"><div class="d-container"><div class="program-heading"><div><p class="d-kicker">BANYAK CARA UNTUK BERTUMBUH</p><h2>Temukan percikan<br /><span>rasa ingin tahunya.</span></h2></div><p>Pilih program dan lihat<br />contoh pengalaman belajarnya.</p></div><div class="program-tabs" role="tablist" aria-label="Program belajar">{programs.map((program,index)=><button type="button" id={`tab-${program.id}`} role="tab" aria-selected={index===0} aria-controls={`panel-${program.id}`} tabindex={index===0?0:-1} data-program-tab={index}>{program.name}<span>↗</span></button>)}</div>{programs.map((program,index)=><article class="program-panel" role="tabpanel" id={`panel-${program.id}`} aria-labelledby={`tab-${program.id}`} hidden={index!==0} tabindex="0" style={`--panel-bg:${program.color}`}><div class="program-copy"><p class="d-kicker">{program.tag}</p><h3>{program.title}</h3><p>{program.description}</p><ul>{program.activities.map(activity=><li><span aria-hidden="true">✦</span>{activity}</li>)}</ul><a href="#kunjungan" class="program-visit" data-visit-program={program.name}>Kenali program ini ↗</a></div><img src={`/images/demo-assets/${program.image}.webp`} data-fallback="/images/demo/sekolah.svg" alt={program.alt} width="800" height="650" loading="lazy" /></article>)}</div></section>
  <section class="school-journey d-container d-section"><p class="d-kicker">LANGKAH PERTAMA YANG NYAMAN</p><h2>Mari saling mengenal.</h2><div class="journey-grid"><article><span>1</span><div><h3>Pilih minat</h3><p>Jelajahi program yang menarik bagi keluarga Anda.</p></div></article><article><span>2</span><div><h3>Rencanakan kunjungan</h3><p>Pilih waktu untuk mengenal lingkungan sekolah.</p></div></article><article><span>3</span><div><h3>Mulai percakapan</h3><p>Bahas kebutuhan belajar dan pertanyaan Anda.</p></div></article></div></section>
  <section id="kunjungan" class="school-visit"><div class="d-container visit-grid"><div><p class="d-kicker">SATU LANGKAH MENUJU CERITA BARU</p><h2>Kenali tempat<br />mereka <span>bertumbuh.</span></h2><p>Coba pendaftaran kunjungan sekolah. Pilih program dan jadwal, lalu lihat ringkasan kunjungan Anda.</p><span class="visit-note">SIMULASI · Tidak ada data yang dikirim.<br />Gunakan nama contoh untuk mencoba formulir.</span><span class="visit-star" aria-hidden="true">✳</span></div><form id="school-form"><label class="d-field">Nama orang tua / wali<input name="parent" required minlength="2" maxlength="80" placeholder="Contoh: Bapak / Ibu Budi" /></label><div class="d-form-grid"><label class="d-field">Jenjang yang diminati<select name="level" required><option value="">Pilih jenjang</option><option>SD</option><option>SMP</option><option>SMA</option></select></label><label class="d-field">Program pilihan<select name="program" id="school-program">{programs.map(program=><option>{program.name}</option>)}</select></label></div><label class="d-field">Jadwal kunjungan (simulasi)<select name="schedule" required><option value="">Pilih jadwal</option><option>Sabtu · Sesi pagi, 09.00–10.00 WIB</option><option>Sabtu · Sesi siang, 13.00–14.00 WIB</option><option>Rabu · Sesi sore, 15.00–16.00 WIB</option></select></label><label class="consent"><input name="understood" type="checkbox" required /><span>Saya memahami bahwa ini simulasi dan bukan pendaftaran sekolah sungguhan.</span></label><button class="d-button" type="submit">Buat rencana kunjungan <span>↗</span></button></form></div></section>
  <footer class="d-container d-footer"><a href="#demo-main" class="school-brand"><span class="brand-symbol" aria-hidden="true">✳</span><span>harapan<br /><b>bangsa.</b></span></a><p>Ruang untuk tumbuh, menjadi, dan bermimpi.<br />Brand sekolah ilustratif · Demo oleh Carisite.</p><a href="/kontak?demo=sekolah">Buat website sekolah Anda ↗</a></footer>
 </div>
 <dialog class="d-dialog" id="school-dialog" aria-labelledby="school-dialog-title"><button type="button" data-close-dialog>Tutup ×</button><p class="d-kicker">RENCANA KUNJUNGAN · SIMULASI</p><h2 id="school-dialog-title">Sampai jumpa di cerita baru.</h2><div class="d-result" id="school-summary"></div><p>Simulasi selesai. Jadwal ini hanya contoh; tidak ada kunjungan, pendaftaran, atau pesan yang dikirim.</p><button class="d-button" type="button" data-close-dialog>Kembali jelajahi sekolah</button></dialog>
</DemoLayout>
<script>
 const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-program-tab]'));
 const activate=(index:number,focus=false)=>{tabs.forEach((tab,i)=>{const active=index===i;tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;document.getElementById(tab.getAttribute('aria-controls')!)!.hidden=!active;});if(focus)tabs[index].focus();};
 tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activate(index));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();activate(next,true);});});
 document.querySelectorAll<HTMLAnchorElement>('[data-visit-program]').forEach(link=>link.addEventListener('click',()=>{(document.getElementById('school-program') as HTMLSelectElement).value=link.dataset.visitProgram!;}));
 document.getElementById('school-form')!.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const data=new FormData(form),output=document.getElementById('school-summary')!;output.replaceChildren();[['Orang tua / wali',data.get('parent')],['Jenjang',data.get('level')],['Minat program',data.get('program')],['Sesi ilustratif',data.get('schedule')]].forEach(([label,value])=>{const p=document.createElement('p'),strong=document.createElement('strong');strong.textContent=label+': ';p.append(strong,document.createTextNode(String(value)));output.append(p);});(document.getElementById('school-dialog') as HTMLDialogElement).showModal();});
</script>
<style>
 .school{--accent:#243b67;--button-text:#fff;background:#f9f7f2;color:#243b67}.school-nav{height:105px;display:flex;justify-content:space-between;align-items:center}.school-brand{display:flex;align-items:center;gap:12px;font-size:20px;line-height:1.05;letter-spacing:-.6px}.school-brand b{font-weight:700}.brand-symbol{font-size:47px;color:#e88960;line-height:1}.school-nav nav{display:flex;align-items:center;gap:30px;font-size:12px}.school .d-button{border-radius:8px}.school-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;padding-top:45px;padding-bottom:80px;align-items:center}.school-hero .d-kicker{font-size:9px;letter-spacing:.09em}.small-spark{font-size:16px;margin-right:5px;color:#b25731}.school-hero h1{font-size:clamp(48px,5.4vw,73px);line-height:1.08;letter-spacing:-4px;font-weight:600;margin:26px 0}.school-hero h1>span{color:#aa5737}.hero-lead{font-size:14px;line-height:1.9;max-width:390px;color:#60687a}.hero-actions{display:flex;align-items:center;gap:22px;margin-top:30px}.secondary-link{font-size:10px;border-bottom:1px solid #b9c1d0;padding-block:12px}.hero-note{font-size:8px;letter-spacing:.1em;color:#60687a;margin-top:35px}.school-visual{position:relative;height:530px;padding:20px 10px 20px 0}.school-visual>img{position:relative;z-index:1;width:100%;height:100%;border-radius:180px 180px 22px 22px;object-position:45% center}.circle-decoration{position:absolute;width:105%;aspect-ratio:1;background:#e9d8ba;border-radius:50%;top:30px;left:-10px}.floating-note{position:absolute;z-index:2;bottom:50px;left:-30px;background:#f8e6b5;padding:20px 28px;border-radius:10px;display:flex;align-items:center;gap:18px;transform:rotate(-5deg);box-shadow:0 8px 30px #20345414}.floating-note>span{font-size:36px;color:#b3623b}.floating-note p{font-size:16px;line-height:1.4}.image-spark{position:absolute;right:-20px;top:0;color:#e99d76;font-size:100px;z-index:2}.school-band{background:#e2e8f2;padding:25px 20px;display:flex;justify-content:center;gap:36px;align-items:center;font-size:10px;letter-spacing:.08em}.school-band i{font-style:normal;color:#a95939;font-size:18px}.school-values{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.school h2{font-size:40px;line-height:1.18;font-weight:500;letter-spacing:-1.8px;margin-top:22px}.school h2>span{color:#7888a6}.school-values>div>p:not(.d-kicker){font-size:13px;line-height:1.9;color:#60687a;margin-top:25px;max-width:430px}.value-grid{display:grid;gap:24px}.value-grid article{padding:0 0 22px 25px;border-left:3px solid #d9c9ec}.value-grid article:nth-child(2){border-color:#efcbae}.value-grid article:nth-child(3){border-color:#bfd8ce}.value-grid span{font-size:9px;letter-spacing:.1em}.value-grid h3{font-size:18px;font-weight:500;margin:10px 0}.value-grid p{font-size:12px;color:#60687a;line-height:1.7}.program-section{background:#eceef2;padding-block:75px}.program-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:35px}.program-heading>p{font-size:12px;line-height:1.8;color:#60687a}.program-tabs{display:flex;gap:10px;margin-bottom:25px}.program-tabs button{background:transparent;border:1px solid #bfc7d2;padding:16px 23px;border-radius:8px;font-size:12px;color:#344869;display:flex;gap:35px;align-items:center}.program-tabs button[aria-selected=true]{background:#243b67;border-color:#243b67;color:#fff}.program-panel{display:grid;grid-template-columns:1fr 1fr;background:var(--panel-bg);border-radius:16px;overflow:hidden;min-height:420px}.program-copy{padding:45px}.program-copy .d-kicker{font-size:9px}.program-copy h3{font-size:33px;font-weight:500;line-height:1.18;letter-spacing:-1.2px;margin:22px 0}.program-copy>p:not(.d-kicker){font-size:12px;line-height:1.9;color:#50637f}.program-copy ul{list-style:none;padding:0;margin:25px 0}.program-copy li{font-size:11px;line-height:1.8;margin-top:10px;display:flex;gap:10px}.program-copy li span{color:#657698}.program-visit{font-size:11px;border-bottom:1px solid;padding:8px 0;display:inline-block}.program-panel>img{height:100%;width:100%;min-height:420px}.school-journey{text-align:center}.journey-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:35px;text-align:left;margin-top:45px}.journey-grid article{display:flex;align-items:start;gap:18px}.journey-grid article>span{width:44px;height:44px;flex-shrink:0;display:grid;place-items:center;background:#eee4ce;border-radius:50%;font-family:Georgia;font-size:22px}.journey-grid article:nth-child(2)>span{background:#e6dff0}.journey-grid article:nth-child(3)>span{background:#e2ece4}.journey-grid h3{font-size:14px;font-weight:500;margin:3px 0 12px}.journey-grid p{font-size:12px;line-height:1.8;color:#60687a}.school-visit{background:#243b67;color:#fff;padding-block:75px}.visit-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.school-visit h2{font-size:48px}.school-visit h2 span{color:#eed5a7}.school-visit p:not(.d-kicker){font-size:13px;line-height:1.9;color:#c4cede;margin-top:23px;max-width:340px}.visit-note{display:block;font-size:10px;line-height:1.8;color:#c4cede;margin-top:25px}.visit-star{display:block;font-size:85px;line-height:1;color:#eed5a7;margin-top:24px}.visit-grid form{background:#fffaf2;color:#243b67;border-radius:14px;padding:35px;display:grid;gap:20px}.visit-grid .d-field input,.visit-grid .d-field select{border-color:#d3d8e0;border-radius:6px}.consent{display:flex;gap:10px;font-size:10px;line-height:1.7;align-items:start}.consent input{margin-top:2px;min-width:17px;height:17px;accent-color:#243b67}.d-footer{border:0;align-items:center;padding-block:40px}.d-footer p{color:#60687a}
 @media(max-width:1000px){.school-hero{gap:35px}.hero-actions{flex-direction:column;align-items:start;gap:8px}.school-values,.visit-grid{gap:50px}.program-copy{padding:32px}.school-band{gap:20px;font-size:9px}.school-visual{height:480px}.program-tabs button{gap:20px}}
 @media(max-width:700px){.school-nav{height:90px}.school-nav nav>a:not(.d-button){display:none}.school-nav .d-button{font-size:10px;padding:10px 14px;min-height:43px}.school-brand{font-size:17px;gap:8px}.brand-symbol{font-size:37px}.school-hero{grid-template-columns:1fr;padding-top:25px;padding-bottom:45px;gap:28px}.school-hero h1{font-size:54px;letter-spacing:-3.4px}.hero-actions{flex-direction:row;align-items:center;gap:16px}.secondary-link{font-size:9px}.school-visual{height:420px;margin:0 20px}.floating-note{left:-15px;bottom:45px}.image-spark{font-size:80px;right:-15px}.school-band{gap:12px;font-size:7px;flex-wrap:wrap;padding:20px 15px}.school-band i{font-size:12px}.school-band>span:last-child,.school-band>i:last-of-type{display:none}.school-values{grid-template-columns:1fr;gap:35px}.school h2{font-size:33px}.school-values .d-kicker{font-size:9px}.program-section{padding-block:50px}.program-heading{display:block}.program-heading>p{margin-top:20px}.program-tabs{gap:7px}.program-tabs button{padding:13px 10px;font-size:10px;flex:1;justify-content:center;line-height:1.5}.program-tabs button>span{display:none}.program-panel{grid-template-columns:1fr}.program-copy{padding:28px}.program-panel>img{min-height:0;height:250px}.program-copy h3{font-size:30px}.journey-grid{grid-template-columns:1fr;gap:25px}.school-journey{text-align:left}.visit-grid{grid-template-columns:1fr;gap:35px}.school-visit{padding-block:50px}.school-visit h2{font-size:40px}.visit-star{display:none}.visit-grid form{padding:25px}.d-footer{align-items:start}}
</style>
