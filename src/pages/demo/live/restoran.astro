---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Icon } from 'astro-icon/components'

const WA = '6281234567890'
const reserveLink = `https://wa.me/${WA}?text=${encodeURIComponent('Halo Rasa Nusantara, saya ingin reservasi meja.')}`

const HERO_IMG =
  'https://lh3.googleusercontent.com/aida-public/AB6AXuCQWzJ4GgxureyK7grignZ-1do1y6IU324H7kfOZMQ_63lIpBs42BalDx6915-V1E-qekbqhCMeQ1Nr8c0E9KN292WKHEkXXvL-Go5fpp4l8m8gJhuPl2UbzteCCoIygtqmOXRWnMESZZ_TiXiG6CdkgOHuL4zMX_Vy3NEZM6GbdtpJhzK8iq25l0myn-CWzY31CLk9yhOKmsMTLXzEf8UNv04pP5n0mYdHkkjtLxRk3du3H4c-35FwQ7_Lw-Zbl346HaIFqeQXkgk'
const RENDANG_IMG =
  'https://lh3.googleusercontent.com/aida-public/AB6AXuBNkLwclljoexvX44Wj29hopk53xXZI47Gq-o42MyOtDAaRdJ2M-wj-UX6ckzxSquMBjzbeW8q8HQreuesrZKMnlFb3796fcVcUPdUEHy7obh5hh7KO7ZTycyPvBIoo-RTvA1AiwSlq2LjKjJK8irI3rEc2BAGY_kmGYv0z3NybiGHTMzdXToJjkGcGibBPchA2d97WHvKAg_bb6N-pWG089gqCOTa-MHXJThOXIKbQcF0B1dZm8p_pWWEM6XLfQyKjktgVRN7D_zs'
const INTERIOR_IMG =
  'https://lh3.googleusercontent.com/aida-public/AB6AXuDQ4q6CyJbEIvLz2ExUgnDUmD3_VEX2ttqruB8aUre2a16Kjh7A6xGe6gktoZrOYNKZLMbs08pl8hNC_MZDm2JvN7a86HJ1yAs_Gu2WuiQlUI-NukS_NIV-bpcgiZOaVuxn8-ym3SDZ-lUBKhxgy1BKmpoGG1yn15HX6LxqkWfU1OKnTYMi3nHu0eQ6qX5wmA3gmQE5oA-QMb5MW80z_acuqdMzr5QP1wBPA9VfyfeSgL7QxQLyMrqKYpEr4HZUP64qjyJpFjw5hoU'
---

<BaseLayout
  title="Rasa Nusantara — Demo Website Restoran | Carisite"
  description="Contoh website restoran modern dengan galeri menu dan reservasi via WhatsApp, dibuat oleh Carisite."
>
  <div class="bg-primary-deep px-4 py-2 text-center text-xs text-white sm:px-6">
    Contoh website (demo) yang dibuat oleh Carisite —
    <a href="/#demo" class="font-semibold underline underline-offset-2">lihat demo lain</a>
  </div>

  <!-- Hero -->
  <section class="relative flex min-h-[560px] items-center justify-center overflow-hidden px-4 sm:px-6 lg:min-h-[680px]">
    <div class="absolute inset-0 z-0">
      <img src={HERO_IMG} alt="Aneka hidangan Indonesia di atas meja" width="1280" height="720" loading="eager" class="h-full w-full object-cover opacity-90" />
      <div class="absolute inset-0 bg-gradient-to-r from-surface/90 to-surface/40"></div>
    </div>
    <div class="relative z-10 grid w-full max-w-container items-center gap-16 md:grid-cols-2">
      <div class="flex flex-col gap-6">
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-primary-soft px-3 py-1 text-xs font-semibold text-primary-deep">
          <Icon name="lucide:utensils" class="h-4 w-4" /> Demo Website Restoran Modern
        </span>
        <h1 class="font-heading text-4xl font-extrabold text-ink sm:text-5xl">
          Cita Rasa Autentik,<br /><span class="text-primary">Kenyamanan Modern.</span>
        </h1>
        <p class="max-w-lg text-lg leading-relaxed text-ink-muted">
          Selamat datang di Rasa Nusantara. Kami menyajikan hidangan tradisional dengan
          sentuhan modern di tengah suasana yang hangat dan mengundang.
        </p>
        <div class="mt-2 flex gap-4">
          <a href="#menu" class="flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-white shadow-soft transition hover:scale-105">
            Lihat Menu <Icon name="lucide:arrow-down" class="h-4 w-4" />
          </a>
          <a href="#reservasi" class="rounded-xl border border-outline-variant bg-surface/80 px-6 py-3 text-sm font-semibold text-ink backdrop-blur transition hover:bg-surface-high">Reservasi Meja</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Menu bento -->
  <section id="menu" class="bg-surface-lowest px-4 py-16 sm:px-6 lg:py-20">
    <div class="mx-auto flex max-w-container flex-col gap-12">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="mb-3 font-heading text-3xl font-bold text-ink">Pilihan Terfavorit Kami</h2>
        <p class="text-ink-muted">Jelajahi hidangan andalan kami yang memadukan resep turun-temurun dengan presentasi masa kini.</p>
      </div>
      <div class="grid auto-rows-[250px] grid-cols-1 gap-6 md:grid-cols-12">
        <div class="group relative row-span-2 overflow-hidden rounded-xl shadow-soft md:col-span-8">
          <img src={RENDANG_IMG} alt="Rendang Padang Premium" width="800" height="600" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 w-full p-8">
            <h3 class="mb-2 font-heading text-2xl font-semibold text-white">Rendang Padang Premium</h3>
            <p class="text-white/80">Daging sapi pilihan yang dimasak perlahan selama 8 jam dengan rempah rahasia keluarga.</p>
          </div>
        </div>
        <div class="group relative overflow-hidden rounded-xl shadow-soft md:col-span-4">
          <img src={INTERIOR_IMG} alt="Sate Lilit Bali" width="600" height="400" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute bottom-0 left-0 w-full border-t border-outline-variant bg-surface/90 p-6 backdrop-blur-sm">
            <h4 class="text-sm font-semibold text-ink">Sate Lilit Bali</h4>
          </div>
        </div>
        <div class="flex flex-col items-center justify-center rounded-xl bg-primary p-6 text-center text-white shadow-soft md:col-span-4">
          <Icon name="lucide:book-open" class="mb-4 h-12 w-12" />
          <h4 class="mb-2 font-heading text-xl font-semibold">Lihat Menu Lengkap</h4>
          <p class="mb-4 text-sm text-white/80">Temukan puluhan hidangan lainnya</p>
          <a href="#" class="rounded-full bg-white px-4 py-2 text-xs font-semibold text-primary-deep transition hover:bg-surface-high">Unduh PDF Menu</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Reservation -->
  <section id="reservasi" class="bg-surface-low px-4 py-16 sm:px-6 lg:py-20">
    <div class="mx-auto grid max-w-container items-center gap-16 md:grid-cols-2">
      <div class="h-[400px] overflow-hidden rounded-2xl border border-outline-variant shadow-soft md:h-[500px]">
        <img src={INTERIOR_IMG} alt="Interior restoran modern" width="800" height="600" loading="lazy" class="h-full w-full object-cover" />
      </div>
      <div class="flex flex-col gap-6 rounded-2xl border border-white/40 bg-white/85 p-8 shadow-card backdrop-blur">
        <div>
          <h2 class="mb-2 font-heading text-3xl font-bold text-ink">Pesan Meja Anda</h2>
          <p class="text-ink-muted">Pastikan tempat Anda tersedia. Kami menerima reservasi untuk acara keluarga maupun pertemuan bisnis.</p>
        </div>
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-4 rounded-xl border border-outline-variant bg-surface p-4">
            <span class="rounded-full bg-primary-soft p-3 text-primary-deep"><Icon name="lucide:clock" class="h-5 w-5" /></span>
            <div>
              <h4 class="text-sm font-semibold text-ink">Jam Operasional</h4>
              <p class="text-ink-muted">Setiap Hari: 10:00 – 22:00 WIB</p>
            </div>
          </div>
          <div class="flex items-center gap-4 rounded-xl border border-outline-variant bg-surface p-4">
            <span class="rounded-full bg-primary-soft p-3 text-primary-deep"><Icon name="lucide:map-pin" class="h-5 w-5" /></span>
            <div>
              <h4 class="text-sm font-semibold text-ink">Lokasi Strategis</h4>
              <p class="text-ink-muted">Pusat Kuliner Sudirman, Jakarta</p>
            </div>
          </div>
        </div>
        <a href={reserveLink} target="_blank" rel="noopener noreferrer" class="mt-2 flex items-center justify-center gap-3 rounded-xl bg-[#25D366] px-6 py-4 text-sm font-semibold text-white shadow-soft transition hover:scale-[1.02]">
          <Icon name="lucide:message-circle" class="h-5 w-5" /> Reservasi via WhatsApp
        </a>
        <p class="text-center text-xs text-ink-muted">Respon cepat dalam 5 menit</p>
      </div>
    </div>
  </section>
</BaseLayout>
