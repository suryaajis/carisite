---
import DemoLayout from '../../../layouts/DemoLayout.astro'
import { Icon } from 'astro-icon/components'
const orders=[{id:'ORD-2608',name:'Nadia Putri',email:'nadia@example.com',initial:'NP',color:'purple',product:'Studio Annual',amount:2490000,status:'Paid',date:'10 Nov 2026',method:'Virtual Account'},{id:'ORD-2607',name:'Arif Pratama',email:'arif@example.com',initial:'AP',color:'blue',product:'Team Monthly',amount:890000,status:'Paid',date:'10 Nov 2026',method:'QRIS'},{id:'ORD-2606',name:'Citra Lestari',email:'citra@example.com',initial:'CL',color:'orange',product:'Studio Monthly',amount:249000,status:'Pending',date:'09 Nov 2026',method:'Virtual Account'},{id:'ORD-2605',name:'Bima Saputra',email:'bima@example.com',initial:'BS',color:'green',product:'Team Annual',amount:8900000,status:'Paid',date:'09 Nov 2026',method:'Bank Transfer'},{id:'ORD-2604',name:'Dewi Anggraini',email:'dewi@example.com',initial:'DA',color:'pink',product:'Studio Monthly',amount:249000,status:'Refunded',date:'08 Nov 2026',method:'QRIS'},{id:'ORD-2603',name:'Raka Wijaya',email:'raka@example.com',initial:'RW',color:'blue',product:'Studio Annual',amount:2490000,status:'Paid',date:'08 Nov 2026',method:'Virtual Account'},{id:'ORD-2602',name:'Maya Sari',email:'maya@example.com',initial:'MS',color:'orange',product:'Team Monthly',amount:890000,status:'Pending',date:'07 Nov 2026',method:'QRIS'},{id:'ORD-2601',name:'Fajar Hidayat',email:'fajar@example.com',initial:'FH',color:'green',product:'Studio Monthly',amount:249000,status:'Paid',date:'07 Nov 2026',method:'QRIS'}]
const metrics=[{label:'Total revenue',value:'Rp 48.250.000',growth:'+18.6%',icon:'wallet',note:'vs. previous 30 days'},{label:'Orders',value:'1,248',growth:'+12.8%',icon:'shopping-bag',note:'vs. previous 30 days'},{label:'Active customers',value:'8,549',growth:'+8.2%',icon:'users',note:'vs. previous 30 days'},{label:'Conversion rate',value:'3.62%',growth:'+0.8%',icon:'mouse-pointer-2',note:'vs. previous 30 days'}]
---
<DemoLayout title="Pulse — Your business, at a glance" slug="dashboard" description="Demo dashboard SaaS dengan analitik periode, grafik, pencarian transaksi, detail, dan ekspor CSV.">
 <div class="pulse"><aside class="sidebar"><a href="#overview" class="pulse-logo"><span><Icon name="lucide:activity" size={23}/></span>pulse<span class="logo-dot">.</span></a><div class="workspace"><span class="workspace-icon">S</span><div><b>Studio Workspace</b><small>Pro plan · Demo</small></div><Icon name="lucide:chevrons-up-down" size={14}/></div><p class="nav-label">WORKSPACE</p><nav aria-label="Navigasi dashboard"><a class="active" href="#overview"><Icon name="lucide:layout-dashboard" size={17}/>Overview</a><a href="#revenue"><Icon name="lucide:chart-no-axes-combined" size={17}/>Analytics</a><a href="#orders"><Icon name="lucide:shopping-bag" size={17}/>Orders <span>8</span></a><a href="#customers"><Icon name="lucide:users" size={17}/>Customers</a></nav><div class="sidebar-bottom"><div class="demo-card"><span>✦</span><b>A little clarity.<br/>A lot of possibility.</b><p>Explore your business with a fresh perspective.</p><a href="#revenue">Explore insights ↗</a></div><div class="profile"><span class="avatar purple">AS</span><div><b>Alex Studio</b><small>Workspace owner</small></div><span class="online" role="img" aria-label="Online"></span></div></div></aside>
 <div class="app-content"><header class="app-header"><div class="breadcrumb">Workspace <span>/</span><b>Overview</b></div><div class="header-actions"><span class="demo-label"><i></i> Demo workspace</span><button id="notifications" aria-label="Lihat notifikasi"><Icon name="lucide:bell" size={18}/><i></i></button><span class="avatar purple small">AS</span></div></header><div class="dashboard-main" id="overview"><div class="page-heading"><div><p>TUESDAY, NOVEMBER 10, 2026</p><h1>A good day to grow <span>✦</span></h1><p>Here's what's happening with your business today.</p></div><button id="export-csv" class="secondary"><Icon name="lucide:download" size={15}/>Export report</button></div><div class="overview-controls"><h2>Business overview</h2><label class="period"><Icon name="lucide:calendar-days" size={15}/><select id="period-select" aria-label="Periode analitik"><option value="7">Last 7 days</option><option value="30" selected>Last 30 days</option><option value="90">Last 90 days</option></select></label></div>
 <div class="metrics">{metrics.map((metric,index)=><article class="metric"><div class="metric-heading"><span>{metric.label}</span><Icon name={`lucide:${metric.icon}`} size={16}/></div><strong data-metric={index}>{metric.value}</strong><p><span data-growth={index}>{metric.growth}</span><small data-period-note>{metric.note}</small></p><svg class="sparkline" viewBox="0 0 150 28" aria-hidden="true"><path d={index%2===0?'M0 25 L12 19 L24 22 L36 13 L48 18 L60 11 L72 14 L84 6 L96 12 L108 3 L120 7 L132 2 L150 0':'M0 23 L12 25 L24 17 L36 20 L48 10 L60 15 L72 11 L84 15 L96 6 L108 10 L120 4 L132 7 L150 1'}/></svg></article>)}</div>
 <div class="chart-grid"><section id="revenue" class="panel revenue-panel"><div class="panel-heading"><div><h2>Revenue overview</h2><p>A little progress, every single day.</p></div><span class="legend"><i></i><span id="chart-period">Last 30 days</span></span></div><div class="chart-toolbar"><div><strong id="chart-total">Rp 48.250.000</strong><span class="growth" id="chart-growth">↗ 18.6%</span></div><div class="chart-tabs" role="group" aria-label="Jenis grafik"><button class="active" data-chart="revenue" aria-pressed="true">Revenue</button><button data-chart="orders" aria-pressed="false">Orders</button></div></div><div class="chart"><div class="y-labels"><span id="y-high">20 jt</span><span id="y-mid">10 jt</span><span>0</span></div><svg id="main-chart" viewBox="0 0 680 200" preserveAspectRatio="none" role="img" aria-labelledby="chart-title chart-desc"><title id="chart-title">Pendapatan 30 hari terakhir</title><desc id="chart-desc">Grafik ilustrasi data demo dengan tren pendapatan meningkat.</desc><defs><linearGradient id="pulse-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#8b5cf6" stop-opacity=".22"/><stop offset="100%" stop-color="#8b5cf6" stop-opacity="0"/></linearGradient></defs><path class="chart-gridline" d="M0 10H680 M0 95H680 M0 185H680"/><path id="chart-area" d="M0 155 L62 143 L124 155 L186 105 L248 120 L310 65 L372 92 L434 52 L496 70 L558 30 L620 44 L680 12 L680 190 L0 190Z" fill="url(#pulse-fill)"/><path id="chart-line" d="M0 155 L62 143 L124 155 L186 105 L248 120 L310 65 L372 92 L434 52 L496 70 L558 30 L620 44 L680 12"/><circle id="chart-dot" cx="680" cy="12" r="5" fill="#8b5cf6" stroke="white" stroke-width="3"/></svg><div class="x-labels" id="chart-labels"><span>Oct 12</span><span>Oct 18</span><span>Oct 24</span><span>Oct 30</span><span>Nov 05</span><span>Nov 10</span></div></div><div class="chart-footer"><span><Icon name="lucide:trending-up" size={14}/>Your business is moving in the right direction.</span><span>Illustrative demo data</span></div></section>
 <section class="panel channels"><div class="panel-heading"><div><h2>Acquisition</h2><p>Where good things begin.</p></div><Icon name="lucide:pie-chart" size={17}/></div><div class="donut" role="img" aria-label="Organic 42%, Direct 28%, Social 18%, Referral 12%"><div><span>Total visitors</span><strong id="visitor-total">24,680</strong><small>↑ 14.2% this period</small></div></div><div class="channel-list">{[{name:'Organic search',percent:42,color:'#8b5cf6'},{name:'Direct',percent:28,color:'#b6a1f0'},{name:'Social media',percent:18,color:'#d7c9f9'},{name:'Referral',percent:12,color:'#eee8fa'}].map(channel=><div><span><i style={`background:${channel.color}`}></i>{channel.name}</span><b>{channel.percent}%</b></div>)}</div></section></div>
 <section id="orders" class="panel orders-panel"><div class="panel-heading"><div><h2>Recent orders <span class="count-pill">8</span></h2><p>The people behind your progress.</p></div><label class="status-filter"><select id="status-filter" aria-label="Filter status pesanan"><option value="all">All statuses</option><option>Paid</option><option>Pending</option><option>Refunded</option></select></label></div><div class="orders-search"><Icon name="lucide:search" size={16}/><input id="order-search" type="search" placeholder="Search customer, order, or product…" aria-label="Cari pelanggan, pesanan, atau produk"/><span id="order-count" aria-live="polite">Showing 8 orders</span></div><div class="table-scroll"><table><thead><tr><th>Order ID</th><th>Customer</th><th>Product</th><th>Date</th><th>Amount</th><th>Status</th><th><span class="sr-only">Detail</span></th></tr></thead><tbody>{orders.map((order,index)=><tr data-order-row={index}><td class="order-id">#{order.id}</td><td><div class="customer"><span class={`avatar ${order.color}`}>{order.initial}</span><div><b>{order.name}</b><small>{order.email}</small></div></div></td><td>{order.product}</td><td>{order.date}</td><td class="amount">Rp {new Intl.NumberFormat('id-ID').format(order.amount)}</td><td><span class={`status ${order.status.toLowerCase()}`}><i></i>{order.status}</span></td><td><button data-order={index} class="detail-button" aria-label={`Lihat detail ${order.id}`}>↗</button></td></tr>)}</tbody></table></div><p id="empty-orders" hidden>No matching orders. Try a different search or status.</p><div class="table-footer"><span>Sample transactions · November 2026</span><span>All 8 records loaded</span></div></section>
 <section id="customers" class="bottom-grid"><div class="insight-card"><span class="insight-icon"><Icon name="lucide:sparkles" size={23}/></span><div><p>YOUR WEEKLY SPARK</p><h2>Good products bring people back.</h2><p>Returning customers make up <b>32% of orders</b> in this sample workspace. Consistency is your quiet superpower.</p><a href="#orders">Get to know your customers ↗</a></div></div><div class="panel customer-panel"><h2>Customer happiness</h2><div><strong>4.9<span>/5</span></strong><p>★★★★★<small>From 128 sample responses</small></p></div><p>Small moments. Lasting impressions.</p></div></section><footer class="dashboard-footer"><span>Made for the way you work.</span><span>Pulse © 2026 · All metrics are demo data.</span></footer><p id="export-status" class="sr-only" role="status"></p></div></div>
 <dialog id="order-dialog" aria-labelledby="order-title"><button class="close" aria-label="Tutup detail">×</button><p class="dialog-kicker">ORDER DETAILS · DEMO DATA</p><h2 id="order-title"></h2><dl id="order-details"></dl><p class="dialog-note">This is a sample record. No real customer or payment information is used.</p><button class="primary" id="close-order">Done</button></dialog><dialog id="notification-dialog" aria-labelledby="notifications-title"><button class="close" aria-label="Tutup notifikasi">×</button><p class="dialog-kicker">YOUR WORKSPACE</p><h2 id="notifications-title">You're all caught up.</h2><div class="notification-item"><span>✦</span><div><b>Your report is ready to explore</b><p>Use the period selector to discover sample insights for 7, 30, or 90 days.</p><small>Just now · Demo notification</small></div></div><div class="notification-item"><span>✓</span><div><b>Welcome to Pulse</b><p>Search orders, inspect transactions, and export the visible records as CSV.</p><small>Today · Demo notification</small></div></div></dialog>
 </div>
 <script define:vars={{orders}}>
 const money=v=>'Rp '+new Intl.NumberFormat('id-ID').format(v);const periods={7:{values:['Rp 12.840.000','312','2,186','3.48%'],growth:['+12.4%','+9.6%','+6.1%','+0.4%'],visitors:'6,240',revenue:[143,130,151,110,85,95,47,60,24,38,20,10],orders:[170,130,144,109,120,75,100,70,86,42,65,30],labels:['Nov 04','Nov 05','Nov 06','Nov 07','Nov 08','Nov 10'],high:'5 jt',mid:'2,5 jt'},30:{values:['Rp 48.250.000','1,248','8,549','3.62%'],growth:['+18.6%','+12.8%','+8.2%','+0.8%'],visitors:'24,680',revenue:[155,143,155,105,120,65,92,52,70,30,44,12],orders:[160,140,150,100,110,125,70,80,40,60,20,35],labels:['Oct 12','Oct 18','Oct 24','Oct 30','Nov 05','Nov 10'],high:'20 jt',mid:'10 jt'},90:{values:['Rp 142.780.000','3,690','24,210','3.81%'],growth:['+24.2%','+19.4%','+15.7%','+1.2%'],visitors:'72,450',revenue:[172,158,130,145,117,100,120,72,80,45,61,18],orders:[180,160,165,138,120,145,98,110,72,60,80,22],labels:['Aug 13','Aug 31','Sep 18','Oct 06','Oct 24','Nov 10'],high:'60 jt',mid:'30 jt'}};let chartType='revenue';function updateChart(){const days=document.querySelector('#period-select').value,p=periods[days];document.querySelectorAll('[data-metric]').forEach((el,i)=>el.textContent=p.values[i]);document.querySelectorAll('[data-growth]').forEach((el,i)=>el.textContent=p.growth[i]);document.querySelectorAll('[data-period-note]').forEach(el=>el.textContent='vs. previous '+days+' days');document.querySelector('#visitor-total').textContent=p.visitors;document.querySelector('#chart-total').textContent=p.values[chartType==='revenue'?0:1];document.querySelector('#chart-growth').textContent='↗ '+p.growth[chartType==='revenue'?0:1].slice(1);document.querySelector('#chart-period').textContent='Last '+days+' days';document.querySelector('#chart-title').textContent=(chartType==='revenue'?'Pendapatan':'Pesanan')+' '+days+' hari terakhir';document.querySelector('#chart-desc').textContent='Data ilustrasi '+(chartType==='revenue'?'pendapatan '+p.values[0]:'jumlah pesanan '+p.values[1])+'. Bukan data bisnis nyata.';const values=p[chartType],path=values.map((y,i)=>(i?'L':'M')+(i*680/(values.length-1)).toFixed(1)+' '+y).join(' ');document.querySelector('#chart-line').setAttribute('d',path);document.querySelector('#chart-area').setAttribute('d',path+' L680 190 L0 190Z');document.querySelector('#chart-dot').setAttribute('cy',String(values[values.length-1]));document.querySelector('#y-high').textContent=chartType==='revenue'?p.high:(days==='7'?'150':days==='30'?'600':'1.8k');document.querySelector('#y-mid').textContent=chartType==='revenue'?p.mid:(days==='7'?'75':days==='30'?'300':'900');document.querySelectorAll('#chart-labels span').forEach((el,i)=>el.textContent=p.labels[i]);document.querySelectorAll('[data-chart]').forEach(b=>{b.classList.toggle('active',b.dataset.chart===chartType);b.setAttribute('aria-pressed',String(b.dataset.chart===chartType))})}document.querySelector('#period-select').addEventListener('change',updateChart);document.querySelectorAll('[data-chart]').forEach(b=>b.addEventListener('click',()=>{chartType=b.dataset.chart;updateChart()}));
 function visibleOrders(){const search=document.querySelector('#order-search').value.trim().toLowerCase(),status=document.querySelector('#status-filter').value;return orders.map((order,index)=>({order,index})).filter(({order})=>(status==='all'||order.status===status)&&[order.id,order.name,order.email,order.product].some(value=>value.toLowerCase().includes(search)))}function filterOrders(){const matches=visibleOrders(),ids=new Set(matches.map(item=>item.index));document.querySelectorAll('[data-order-row]').forEach(row=>row.hidden=!ids.has(Number(row.dataset.orderRow)));document.querySelector('#order-count').textContent='Showing '+matches.length+' orders';document.querySelector('#empty-orders').hidden=matches.length>0}document.querySelector('#order-search').addEventListener('input',filterOrders);document.querySelector('#status-filter').addEventListener('change',filterOrders);
 const orderDialog=document.querySelector('#order-dialog');document.querySelectorAll('[data-order]').forEach(button=>button.addEventListener('click',()=>{const order=orders[Number(button.dataset.order)];document.querySelector('#order-title').textContent='#'+order.id;const list=document.querySelector('#order-details');list.replaceChildren();Object.entries({Customer:order.name,Email:order.email,Product:order.product,Amount:money(order.amount),Status:order.status,Date:order.date,'Payment method':order.method}).forEach(([key,value])=>{const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=key;dd.textContent=value;list.append(dt,dd)});orderDialog.showModal()}));document.querySelector('#close-order').addEventListener('click',()=>orderDialog.close());const notificationDialog=document.querySelector('#notification-dialog');document.querySelector('#notifications').addEventListener('click',()=>notificationDialog.showModal());[orderDialog,notificationDialog].forEach(dialog=>{dialog.querySelector('.close').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()})});document.querySelector('#export-csv').addEventListener('click',()=>{const rows=[['Order ID','Customer','Email','Product','Date','Amount IDR','Status'],...visibleOrders().map(({order:o})=>[o.id,o.name,o.email,o.product,o.date,o.amount,o.status])];const csv='\uFEFF'+rows.map(row=>row.map(value=>'"'+String(value).replaceAll('"','""')+'"').join(',')).join('\r\n');const url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download='pulse-demo-orders.csv';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);document.querySelector('#export-status').textContent=visibleOrders().length+' sample orders exported as CSV.'});document.querySelectorAll('.sidebar nav a').forEach(link=>link.addEventListener('click',()=>{document.querySelectorAll('.sidebar nav a').forEach(a=>a.classList.remove('active'));link.classList.add('active')}));
 </script>
 <style>
 .pulse{display:flex;background:#f7f8fc;color:#252638;font-family:Arial,sans-serif;min-height:1000px;font-size:12px}.sidebar{width:225px;flex-shrink:0;background:#fff;border-right:1px solid #eaeaf0;padding:30px 20px;display:flex;flex-direction:column}.pulse-logo{display:flex;align-items:center;font-size:29px;font-weight:700;letter-spacing:-1.4px;text-decoration:none;color:#2d293c;gap:9px;margin:0 7px 34px}.pulse-logo>span:first-child{width:33px;height:33px;display:grid;place-items:center;border-radius:10px;background:#8b5cf6;color:white}.pulse-logo .logo-dot{color:#8b5cf6;margin-left:-9px}.workspace{display:flex;align-items:center;gap:10px;padding:12px 9px;border:1px solid #e8e7ef;border-radius:8px}.workspace-icon{background:#f0ebfb;color:#8566c5;border:1px solid #ded4f6;font-size:13px;font-weight:600;width:28px;height:28px;border-radius:6px;display:grid;place-items:center}.workspace>div{flex:1}.workspace b,.profile b{font-size:10px;font-weight:500;display:block}.workspace small,.profile small{font-size:8px;color:#6f6e7a;display:block;margin-top:5px}.nav-label{font-size:8px;font-weight:600;letter-spacing:1.5px;color:#706f7a;margin:30px 11px 12px}.sidebar nav{display:flex;flex-direction:column;gap:5px}.sidebar nav a{display:flex;align-items:center;gap:12px;color:#72707f;text-decoration:none;padding:12px;font-size:11px;border-radius:7px}.sidebar nav a.active{color:#7551b7;background:#f1ebfd;font-weight:600}.sidebar nav a>span{margin-left:auto;border:1px solid #ddd9e7;padding:2px 5px;border-radius:4px;font-size:8px}.sidebar-bottom{margin-top:auto;padding-top:45px}.demo-card{background:linear-gradient(140deg,#f7f4ff,#eef0fb);border:1px solid #ece5f8;padding:17px;border-radius:9px}.demo-card>span{display:block;color:#9a77de;font-size:26px;margin-bottom:10px}.demo-card b{font-size:12px;line-height:1.5;font-weight:500}.demo-card p{font-size:10px;line-height:1.7;color:#9490a7;margin-top:10px}.demo-card a{font-size:9px;display:block;color:#8261c1;text-decoration:none;margin-