---
import DemoLayout from '@/layouts/DemoLayout.astro'
const services = [
  { title: 'Strategi bisnis', label: 'Arah yang lebih jelas.', desc: 'Petakan peluang, tentukan prioritas, dan bangun rencana pertumbuhan yang dapat dijalankan tim Anda.', deliverable: 'Peta peluang, prioritas inisiatif, dan roadmap 90 hari.', time: '4–6 minggu', number: '01' },
  { title: 'Efisiensi operasional', label: 'Ruang untuk lebih baik.', desc: 'Temukan hambatan dalam alur kerja dan rancang proses yang membuat tim bergerak lebih efektif.', deliverable: 'Audit proses, rancangan SOP, dan indikator operasional.', time: '6–8 minggu', number: '02' },
  { title: 'Transformasi digital', label: 'Teknologi yang tepat guna.', desc: 'Selaraskan kebutuhan bisnis dengan pilihan teknologi, dari pemetaan sistem hingga rencana adopsi.', deliverable: 'Pemetaan sistem, rekomendasi teknologi, dan rencana adopsi.', time: '8–12 minggu', number: '03' },
]
---
<DemoLayout title="Artha — Strategy & Advisory" slug="company-profile" description="Simulasi company profile konsultan dengan pemilih layanan dan penyusun brief interaktif.">
  <div class="artha">
    <header class="d-container brand-nav"><a class="brand" href="#demo-main">artha<span>®</span></a><nav aria-label="Navigasi Artha"><a href="#pendekatan">Pendekatan</a><a href="#layanan">Keahlian</a><a class="nav-contact" href="#brief">Mari berdiskusi ↗</a></nav></header>
    <section class="hero d-container">
      <div class="hero-copy"><p class="d-kicker">ARTHA SOLUSI MANDIRI · DEMO BRAND</p><h1>Kejelasan arah.<br />Ketepatan <em>langkah.</em></h1><p class="lead">Mitra berpikir bagi bisnis yang siap bergerak maju. Strategi yang terarah, dari percakapan pertama hingga implementasi.</p><a class="d-button" href="#brief">Temukan langkah berikutnya <span>↗</span></a><div class="hero-note"><span>STRATEGY</span><span>OPERATIONS</span><span>TRANSFORMATION</span></div></div>
      <div class="hero-art"><img src="/images/demo-assets/photo-1486406146926-c627a92ad1ab.webp" data-fallback="/images/demo/company-profile.svg" alt="Garis arsitektur gedung modern mengarah ke langit" width="900" height="1050" fetchpriority="high" /><div class="image-label"><span>Perspektif baru.<br />Kemungkinan baru.</span><span>↗</span></div><div class="art-tag">PERSPECTIVE / 001</div></div>
    </section>
    <section id="pendekatan" class="approach"><div class="d-container approach-grid"><p class="d-kicker">BERANGKAT DARI PEMAHAMAN</p><div><h2>Bisnis Anda unik.<br />Begitu pula jalan ke depannya.</h2><p>Kami memulai dengan mendengar. Memahami tantangan, menguji asumsi, lalu menyusun langkah yang relevan dengan realitas bisnis Anda.</p><div class="steps"><article><span>01 / DISCOVER</span><h3>Pahami konteks</h3><p>Diskusi terbuka tentang ambisi dan tantangan.</p></article><article><span>02 / DESIGN</span><h3>Susun arah</h3><p>Prioritas yang jelas, dengan ruang untuk beradaptasi.</p></article><article><span>03 / DELIVER</span><h3>Gerakkan perubahan</h3><p>Rencana kerja dan indikator untuk memandu tim.</p></article></div></div></div></section>
    <section id="layanan" class="d-container d-section"><div class="section-head"><div><p class="d-kicker">RUANG KEAHLIAN</p><h2>Di mana kita bisa<br />membuat perbedaan?</h2></div><p>Pilih tantangan Anda untuk melihat<br />pendekatan yang sesuai.</p></div><div class="services"><div class="service-list" aria-label="Pilih layanan">{services.map((service, index) => <button data-service={index} aria-pressed={index === 0}><span>{service.number}</span>{service.title}<b aria-hidden="true">↗</b></button>)}</div><article class="service-detail" aria-live="polite"><span class="d-kicker" id="service-number">LAYANAN 01</span><h3 id="service-label">{services[0].label}</h3><p id="service-desc">{services[0].desc}</p><div class="deliverable"><span>HASIL DISKUSI & PROYEK</span><p id="service-deliverable">{services[0].deliverable}</p></div><a class="text-link" href="#brief">Susun brief untuk layanan ini ↗</a></article></div></section>
    <section id="brief" class="brief-section"><div class="d-container brief-grid"><div><p class="d-kicker">MULAI DARI SEBUAH PERCAKAPAN</p><h2>Apa yang ingin<br />Anda <em>ubah?</em></h2><p>Gunakan penyusun brief untuk mendapatkan gambaran awal kerja sama.</p><span class="simulation">SIMULASI · Data tidak dikirim atau disimpan.</span></div><form id="brief-form"><label class="d-field">Nama bisnis<input name="business" required minlength="2" maxlength="100" placeholder="Contoh: Studio Ruang" autocomplete="organization" /></label><label class="d-field">Fokus kebutuhan<select id="brief-service" name="service">{services.map((service,index) => <option value={index}>{service.title}</option>)}</select></label><label class="d-field">Tantangan utama<textarea name="challenge" required minlength="15" maxlength="800" placeholder="Ceritakan tujuan dan hambatan tim Anda (minimal 15 karakter)."></textarea></label><button class="d-button" type="submit">Buat ringkasan brief <span>↗</span></button></form></div></section>
    <footer class="d-container d-footer"><a class="brand" href="#demo-main">artha<span>®</span></a><p>Konsep website konsultan oleh Carisite.<br />Seluruh brand, layanan, dan estimasi adalah ilustrasi.</p><a href="/kontak?demo=company-profile">Diskusikan website Anda ↗</a></footer>
  </div>
  <dialog class="d-dialog" id="brief-dialog" aria-labelledby="brief-title"><button type="button" data-close-dialog>Tutup ×</button><span class="d-kicker">RINGKASAN SIMULASI</span><h2 id="brief-title">Brief awal Anda</h2><div id="brief-output" class="d-result"></div><p class="d-notice">Ini adalah pratinjau alur konsultasi. Tidak ada data yang dikirim. Estimasi durasi merupakan contoh, bukan penawaran.</p><button class="d-button" type="button" data-close-dialog>Kembali ke brief</button></dialog>
</DemoLayout>
<script is:inline define:vars={{ services }}>
  const serviceButtons = document.querySelectorAll('[data-service]');
  const select = document.getElementById('brief-service');
  serviceButtons.forEach(button => button.addEventListener('click', () => {
    const index = Number(button.dataset.service), service = services[index];
    serviceButtons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    document.getElementById('service-number').textContent = 'LAYANAN ' + service.number;
    document.getElementById('service-label').textContent = service.label;
    document.getElementById('service-desc').textContent = service.desc;
    document.getElementById('service-deliverable').textContent = service.deliverable;
    select.value = String(index);
  }));
  document.getElementById('brief-form').addEventListener('submit', event => {
    event.preventDefault(); const form = event.currentTarget; if (!form.reportValidity()) return;
    const data = new FormData(form), service = services[Number(data.get('service'))];
    const output = document.getElementById('brief-output'); output.replaceChildren();
    [['Bisnis', data.get('business')], ['Fokus', service.title], ['Tantangan', data.get('challenge')], ['Usulan hasil', service.deliverable], ['Estimasi ilustratif', service.time]].forEach(([label,value]) => { const p = document.createElement('p'); const strong = document.createElement('strong'); strong.textContent = label + ': '; p.append(strong,document.createTextNode(String(value))); output.append(p); });
    document.getElementById('brief-dialog').showModal();
  });
</script>
<style>
  .artha{--accent:#d5e5a9;--button-text:#203f37;background:#f5f5ee;color:#253e36}.brand-nav{height:100px;display:flex;align-items:center;justify-content:space-between}.brand{font-size:37px;letter-spacing:-2px;font-weight:600}.brand span{font-size:13px;vertical-align:top;line-height:3;letter-spacing:0}.brand-nav nav{display:flex;gap:38px;font-size:12px;align-items:center}.nav-contact{border-bottom:1px solid;padding-bottom:8px}.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;padding-top:35px;padding-bottom:85px;align-items:center}.hero h1{font-size:clamp(44px,5.4vw,74px);font-weight:500;line-height:1.09;letter-spacing:-4px;margin-top:32px}.hero em,.brief-section em{font-family:Georgia,serif;font-weight:400}.lead{font-size:15px;line-height:1.9;max-width:390px;margin:28px 0 30px;color:#63716a}.hero .d-button{background:#244b3f;color:white}.hero-note{display:flex;gap:20px;font-size:8px;letter-spacing:.13em;margin-top:48px}.hero-art{height:550px;position:relative;background:#bac9c0}.hero-art img{width:100%;height:100%;filter:saturate(.45)}.image-label{position:absolute;bottom:0;left:0;right:0;background:#244b3fe8;color:#fff;display:flex;justify-content:space-between;padding:26px 30px;font-size:20px;line-height:1.5;font-family:Georgia,serif}.image-label>span:last-child{font-family:Inter;font-size:40px}.art-tag{position:absolute;top:25px;left:25px;background:#f5f5ee;padding:12px;font-size:9px;letter-spacing:.12em}.approach{padding:76px 0;background:#e9ece2}.approach-grid{display:grid;grid-template-columns:1fr 2fr;gap:70px}.approach h2,.section-head h2{font-size:38px;font-weight:500;letter-spacing:-1.5px;line-height:1.2}.approach-grid>div>p{font-size:14px;line-height:1.9;max-width:600px;color:#5c6860;margin-top:22px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:45px}.steps article{border-top:1px solid #bcc7b8;padding-top:18px}.steps span{font-size:9px;letter-spacing:.08em}.steps h3{font-size:14px;font-weight:500;margin:20px 0 9px}.steps p{font-size:12px;line-height:1.8;color:#5c6860}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:45px}.section-head h2{margin-top:18px}.section-head>p{font-size:12px;line-height:1.8;color:#5c6860}.services{display:grid;grid-template-columns:1fr 1fr;gap:60px}.service-list button{display:flex;align-items:center;gap:25px;width:100%;padding:28px 15px;border:0;border-bottom:1px solid #cbd2c3;background:none;text-align:left;color:inherit;font-size:17px}.service-list button span{font-size:11px;color:#5d685c}.service-list button b{margin-left:auto;font-weight:400}.service-list button[aria-pressed=true]{background:#e7ecdc}.service-detail{background:#e7ecdc;padding:40px}.service-detail h3{font-family:Georgia,serif;font-size:30px;font-weight:400;margin:25px 0 15px}.service-detail p{font-size:13px;line-height:1.8;color:#596b5e}.deliverable{padding-top:22px;margin-top:25px;border-top:1px solid #c4cdb9}.deliverable>span{font-size:9px;letter-spacing:.12em}.deliverable p{margin-top:9px}.text-link{display:block;font-size:12px;margin-top:24px;font-weight:600}.brief-section{background:#244b3f;color:white;padding:80px 0}.brief-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.brief-section h2{font-size:54px;font-weight:400;line-height:1.1;letter-spacing:-2px;margin:25px 0}.brief-section p{color:#c5d3c9;font-size:14px;line-height:1.8;max-width:330px}.simulation{display:block;font-size:10px;margin-top:30px;color:#c5d3c9}.brief-section form{display:grid;gap:18px}.brief-section .d-field input,.brief-section .d-field select,.brief-section .d-field textarea{border-color:#688675;background:#315749;color:#fff}.brief-section input::placeholder,.brief-section textarea::placeholder{color:#c1cfc5}.d-footer{border-color:#d6dcce;align-items:center;padding-block:36px}.d-footer p{color:#617061}
  @media(max-width:760px){.brand-nav{height:78px}.brand-nav nav{gap:18px}.brand-nav nav>a:not(.nav-contact){display:none}.hero{grid-template-columns:1fr;padding-top:25px;gap:35px;padding-bottom:45px}.hero h1{letter-spacing:-2.8px;font-size:52px}.hero-art{height:360px}.hero-note{margin-top:30px;gap:15px}.approach-grid,.brief-grid,.services{grid-template-columns:1fr;gap:30px}.approach{padding:50px 0}.approach h2,.section-head h2{font-size:32px}.steps{gap:14px}.steps h3{font-size:12px}.section-head{display:block}.section-head>p{margin-top:20px}.service-detail{padding:28px}.brief-section{padding:55px 0}.brief-section h2{font-size:46px}.d-footer{align-items:start}}
</style>
