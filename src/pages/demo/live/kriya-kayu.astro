const products = [
  { name: 'Meja Kopi Minimalis', price: 'Rp 1.250.000', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBHHJuIhmC7UhwYW7Sx6_t0a_Wi_ixuA2-aueeeuQrIQDLj1fER4-FSxpGwbcno8XDVwGeyuqn18zJ2klPTgBi58fuM7POHElpue-y_2MsNiWyBuCsUfK9Bw2LTEizAAlOjBABzSv6kgbvWfcDc5fCyHHzoUPTO2OcQOsAk6ncUNHtfKe1BuWSpAIWaYy71PnxAOq8M3-3ofraUKe5TdcEmM1p2jJWFg78C-BH6pZSeipDCus7-I5Cl82grUbQdUDKwkWlLSq_P3YU', desc: 'Kayu jati solid pilihan dengan serat alami yang indah. Desain minimalis untuk ruang keluarga modern maupun Skandinavia.' },
