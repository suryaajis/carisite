---
import DemoLayout from '@/layouts/DemoLayout.astro'
const products = [
 { name:'Kursi Senja', category:'Duduk', price:'Rp 2.450.000', image:'photo-1598300042247-d088f8ab3a91', material:'Jati solid · anyaman rotan', size:'62 × 70 × 78 cm', story:'Garis sederhana dan sandaran lapang untuk jeda yang lebih panjang. Pilihan untuk sudut baca yang tenang.' },
 { name:'Meja Temu', category:'Meja', price:'Rp 3.800.000', image:'photo-1533090161767-e6ffed986c88', material:'Sungkai solid · natural oil', size:'120 × 60 × 42 cm', story:'Permukaan hangat untuk percakapan, buku favorit, dan secangkir kopi. Sudut lembut yang ramah untuk ruang keluarga.' },
 { name:'Kursi Hening', category:'Duduk', price:'Rp 1.850.000', image:'photo-1567538096630-e0c55bd6374c', material:'Oak · kain linen', size:'56 × 58 × 82 cm', story:'Siluet ringan yang menemani keseharian. Bentuk yang sederhana membuatnya mudah berpadu dengan meja kesayangan.' },
 { name:'Rak Sela', category:'Penyimpanan', price:'Rp 2.100.000', image:'photo-1595428774223-ef52624120d2', material:'Sungkai · lapisan matte', size:'80 × 35 × 120 cm', story:'Beri ruang bagi benda-benda yang punya cerita. Penyimpanan terbuka yang menghadirkan ritme pada dinding kosong.' },
]
---
<DemoLayout title="Kriya Kayu — Objects for slow living" slug="kriya-kayu" description="Demo katalog furnitur editorial dengan filter, detail produk, dan daftar pilihan interaktif.">
 <div class="kriya">
  <header class="d-container wood-nav"><a class="wood-brand" href="#demo-main">kriya kayu<span>CRAFTED FOR EVERYDAY</span></a><nav aria-label="Navigasi Kriya Kayu"><a href="#koleksi">Koleksi</a><a href="#cerita">Filosofi</a><button type="button" id="show-shortlist">Pilihan saya <span id="shortlist-count">0</span></button></nav></header>
  <section class="wood-hero"><div class="hero-image"><img src="/images/demo-assets/photo-1600210492486-724fe5c67fb0.webp" data-fallback="/images/demo/kriya-kayu.svg" alt="Ruang keluarga bernuansa alami dengan furnitur kayu" width="1600" height="950" fetchpriority="high" /></div><div class="d-container hero-content"><p class="d-kicker">A SLOWER WAY OF LIVING</p><h1>Ruang yang hangat.<br />Cerita yang <em>dekat.</em></h1><p>Furnitur dengan bentuk bersahaja.<br />Untuk rumah yang terasa seperti Anda.</p><a class="d-button" href="#koleksi">Jelajahi koleksi <span>↗</span></a><span class="hero-caption">KOLEKSI RUANG / KONSEP BRAND DEMO</span></div></section>
  <div class="wood-strip"><span>BENTUK YANG BERSAHAJA</span><i>✳</i><span>TEKSTUR YANG BERCERITA</span><i>✳</i><span>UNTUK KESEHARIAN</span></div>
  <section id="koleksi" class="d-section d-container"><div class="collection-head"><div><p class="d-kicker">PILIHAN UNTUK RUANG ANDA</p><h2>Benda yang ingin<br />Anda <em>tinggali bersama.</em></h2></div><p>Telusuri koleksi, lihat detail,<br />lalu simpan yang Anda sukai.</p></div><div class="filters-row"><div class="d-filter" aria-label="Kategori furnitur">{['Semua','Duduk','Meja','Penyimpanan'].map((category,index)=><button type="button" data-category={category} aria-pressed={index===0}>{category}</button>)}</div><p id="product-count" aria-live="polite">4 objek pilihan</p></div><div class="products">{products.map((p,index)=><article class="product" data-product-category={p.category}><button class="product-image" type="button" data-detail={index} aria-label={`Lihat detail ${p.name}`}><img src={`/images/demo-assets/${p.image}.webp`} data-fallback="/images/demo/kriya-kayu.svg" alt={p.name} width="600" height="700" loading="lazy" /><span>Lihat objek ↗</span></button><div class="product-info"><div><span>{p.category} / 0{index+1}</span><h3>{p.name}</h3><p>{p.price}</p></div><button class="save" type="button" data-save={index} aria-pressed="false" aria-label={`Simpan ${p.name}`}>＋</button></div></article>)}</div><p class="catalog-note">Seluruh produk dan harga adalah contoh untuk demonstrasi katalog. Tidak tersedia pembelian.</p></section>
  <section id="cerita" class="wood-story"><div class="d-container story-grid"><div class="story-image"><img src="/images/demo-assets/photo-1452860606245-08befc0ff44b.webp" data-fallback="/images/demo/kriya-kayu.svg" alt="Meja kerja kreatif dengan detail material dan alat" width="800" height="850" loading="lazy" /></div><div><p class="d-kicker">FILOSOFI KOLEKSI</p><h2>Tidak perlu banyak.<br />Cukup yang <em>bermakna.</em></h2><p>Kami membayangkan rumah sebagai tempat untuk melambat. Tempat material alami, cahaya, dan benda kesayangan bertemu dalam keseimbangan.</p><p>Konsep koleksi ini merayakan tekstur kayu dan bentuk yang fungsional. Setiap objek dipilih untuk menjadi bagian dari ritme hidup sehari-hari.</p><a href="#koleksi" class="story-link">Temukan objek Anda <span>↗</span></a></div></div></section>
  <footer class="d-container d-footer"><span class="wood-brand">kriya kayu</span><p>Objects for slow living.<br />Demo katalog oleh Carisite — brand ilustratif.</p><a href="/kontak?demo=kriya-kayu">Buat katalog untuk brand Anda ↗</a></footer>
 </div>
 <dialog id="product-dialog" class="d-dialog" aria-labelledby="product-title"><button type="button" data-close-dialog>Tutup ×</button><p class="d-kicker">DETAIL OBJEK · SIMULASI</p><h2 id="product-title"></h2><p id="product-story"></p><div id="product-spec" class="d-result"></div><p id="product-price"></p><button id="dialog-save" type="button" class="d-button">Simpan ke pilihan</button></dialog>
 <dialog id="shortlist-dialog" class="d-dialog" aria-labelledby="shortlist-title"><button type="button" data-close-dialog>Tutup ×</button><p class="d-kicker">KURASI PERSONAL</p><h2 id="shortlist-title">Pilihan saya</h2><div id="shortlist-items" aria-live="polite"></div><p class="d-notice">Pilihan tersimpan selama halaman ini terbuka. Ini simulasi, bukan keranjang belanja atau pesanan.</p><button type="button" class="d-button" data-close-dialog>Lanjut jelajahi</button></dialog>
</DemoLayout>
<script is:inline define:vars={{ products }}>
 const saved = new Set(); let activeProduct = 0;
 const update = () => { document.getElementById('shortlist-count').textContent = String(saved.size); document.querySelectorAll('[data-save]').forEach(button => {const active=saved.has(Number(button.dataset.save)); button.setAttribute('aria-pressed',String(active));button.textContent=active?'✓':'＋';button.setAttribute('aria-label',(active?'Hapus ':'Simpan ')+products[Number(button.dataset.save)].name);}); document.getElementById('dialog-save').textContent=saved.has(activeProduct)?'Hapus dari pilihan':'Simpan ke pilihan'; };
 const toggle = index => {saved.has(index)?saved.delete(index):saved.add(index);update();};
 document.querySelectorAll('[data-save]').forEach(button => button.addEventListener('click',()=>toggle(Number(button.dataset.save))));
 document.querySelectorAll('[data-category]').forEach(button => button.addEventListener('click',()=>{document.querySelectorAll('[data-category]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));let count=0;document.querySelectorAll('[data-product-category]').forEach(card=>{const visible=button.dataset.category==='Semua'||card.dataset.productCategory===button.dataset.category;card.hidden=!visible;if(visible)count++;});document.getElementById('product-count').textContent=count+' objek pilihan';}));
 document.querySelectorAll('[data-detail]').forEach(button=>button.addEventListener('click',()=>{activeProduct=Number(button.dataset.detail);const product=products[activeProduct];document.getElementById('product-title').textContent=product.name;document.getElementById('product-story').textContent=product.story;document.getElementById('product-spec').textContent=product.material+' · Ukuran '+product.size;document.getElementById('product-price').textContent=product.price+' — harga ilustratif';update();document.getElementById('product-dialog').showModal();}));
 document.getElementById('dialog-save').addEventListener('click',()=>toggle(activeProduct));
 const renderShortlist=()=>{const target=document.getElementById('shortlist-items');target.replaceChildren();if(!saved.size){const p=document.createElement('p');p.textContent='Belum ada pilihan. Gunakan tombol + pada objek yang Anda sukai.';target.append(p);}saved.forEach(index=>{const row=document.createElement('div');row.style.cssText='display:flex;gap:16px;align-items:center;justify-content:space-between;padding:16px 0;border-bottom:1px solid #ddd3c5';const text=document.createElement('span');text.textContent=products[index].name+' · '+products[index].price;const button=document.createElement('button');button.type='button';button.textContent='Hapus';button.style.cssText='padding:10px;background:transparent;border:1px solid #b9ac98';button.setAttribute('aria-label','Hapus '+products[index].name);button.addEventListener('click',()=>{toggle(index);renderShortlist();document.querySelector('#shortlist-items button')?.focus();});row.append(text,button);target.append(row);});};
 document.getElementById('show-shortlist').addEventListener('click',()=>{renderShortlist();document.getElementById('shortlist-dialog').showModal();});
</script>
<style>
 .kriya{--accent:#4c4438;--button-text:#fff8ee;background:#f5f1e9;color:#3f392f}.wood-nav{display:flex;justify-content:space-between;align-items:center;min-height:105px}.wood-brand{font-family:Georgia,serif;font-size:32px;letter-spacing:-1.7px}.wood-brand span{display:block;font-family:Inter,sans-serif;font-size:8px;letter-spacing:.19em;margin-top:6px}.wood-nav nav{display:flex;align-items:center;gap:34px;font-size:12px}.wood-nav button{border:0;background:transparent;color:inherit;padding:10px 0;font-size:12px}.wood-nav button span{display:inline-grid;place-items:center;width:24px;height:24px;background:#e3dccf;border-radius:50%;margin-left:5px}.wood-hero{position:relative;min-height:660px;background:#3a352e;color:#fff9ef}.hero-image{position:absolute;inset:0}.hero-image::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#211c13bb 0%,#211c1366 50%,#211c1310 100%)}.hero-image img{height:100%;width:100%}.hero-content{position:relative;padding-top:100px;padding-bottom:35px}.hero-content h1{font-family:Georgia,serif;font-size:clamp(48px,5.3vw,74px);font-weight:400;letter-spacing:-2.6px;line-height:1.12;margin:27px 0}.hero-content h1 em{font-weight:400;color:#f0d5a7}.hero-content>p:not(.d-kicker){font-size:14px;line-height:1.9;color:#f0e8da}.hero-content .d-button{margin-top:30px;background:#f4eddf;color:#41392a}.hero-caption{display:block;font-size:9px;letter-spacing:.15em;margin-top:65px}.wood-strip{background:#e8e1d3;display:flex;justify-content:center;align-items:center;gap:70px;padding:24px 20px;font-size:10px;letter-spacing:.13em}.wood-strip i{font-size:22px;font-style:normal}.collection-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:40px}.collection-head h2,.story-grid h2{font-family:Georgia,serif;font-size:45px;font-weight:400;line-height:1.15;letter-spacing:-1.4px;margin-top:20px}.collection-head h2 em,.story-grid h2 em{font-weight:400;color:#927e61}.collection-head>p{font-size:12px;line-height:1.9;color:#6e675a}.filters-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px}.filters-row>p{font-size:11px;color:#6e675a}.products{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.product-image{display:block;position:relative;aspect-ratio:3/4;width:100%;padding:0;border:0;background:#e4ddcf;overflow:hidden}.product-image img{width:100%;height:100%;transition:transform .5s;filter:saturate(.7)}.product-image:hover img{transform:scale(1.04)}.product-image>span{position:absolute;bottom:12px;left:12px;background:#f5f1e9ed;padding:11px 15px;font-size:10px}.product-info{display:flex;justify-content:space-between;gap:10px;padding-top:20px}.product-info span{font-size:9px;color:#716957}.product-info h3{font-family:Georgia,serif;font-size:23px;font-weight:400;margin:10px 0}.product-info p{font-size:11px;color:#6f6252}.save{width:42px;height:42px;border:1px solid #c8bfaf;background:transparent;font-size:23px;color:#554936}.save[aria-pressed=true]{background:#524735;color:#fff}.catalog-note{font-size:10px;line-height:1.7;color:#72685a;margin-top:36px}.wood-story{background:#e9e3d7;padding:70px 0}.story-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:100px}.story-image{height:450px}.story-image img{width:100%;height:100%;filter:saturate(.6)}.story-grid>div>p:not(.d-kicker){font-size:13px;line-height:1.9;color:#6c6151;margin-top:24px;max-width:400px}.story-link{display:flex;justify-content:space-between;border-bottom:1px solid #a99b85;padding:20px 0;font-size:12px;max-width:350px;margin-top:20px}.d-footer{border:0;align-items:center;padding-block:45px}.d-footer p{color:#726858}
 @media(max-width:850px){.products{grid-template-columns:1fr 1fr}.story-grid{gap:40px}.wood-strip{gap:25px;font-size:8px}.wood-strip i{font-size:16px}.wood-nav nav{gap:20px}.collection-head h2,.story-grid h2{font-size:37px}}
 @media(max-width:600px){.wood-nav{min-height:90px}.wood-nav nav>a{display:none}.wood-brand{font-size:29px}.wood-hero{min-height:610px}.hero-content{padding-top:75px}.hero-content h1{font-size:49px}.hero-image::after{background:#211c1388}.wood-strip{gap:12px;padding:20px 12px;letter-spacing:.04em;font-size:7px}.wood-strip i{font-size:12px}.collection-head{display:block}.collection-head>p{margin-top:20px}.filters-row{display:block}.filters-row>p{margin-top:18px}.d-filter{gap:6px}.d-filter button{padding:10px 13px;font-size:10px}.products{gap:28px 16px}.product-info h3{font-size:20px}.product-info{gap:5px}.save{width:35px;height:40px;flex-shrink:0}.product-image>span{font-size:8px;left:8px;bottom:8px;padding:9px}.story-grid{grid-template-columns:1fr;gap:35px}.story-image{height:320px}.wood-story{padding:40px 0}.d-footer{align-items:start}}
</style>
