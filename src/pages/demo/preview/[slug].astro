---
import {getCollection} from 'astro:content'
export async function getStaticPaths(){const entries=(await getCollection('demo')).sort((a,b)=>a.data.order-b.data.order);return entries.map(entry=>({params:{slug:entry.id},props:{entry,entries}}))}
const {entry,entries}=Astro.props
---
<!doctype html><html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,follow"/><meta name="description" content={entry.data.description}/><title>{entry.data.title} — Live Preview | Carisite</title><link rel="icon" href="/favicon.svg"/></head><body>
<header class="viewer-toolbar"><a class="viewer-brand" href="/demo" aria-label="Kembali ke katalog demo">c<span>↗</span></a><label class="demo-choice"><span>Jelajahi konsep</span><select id="demo-select" aria-label="Pilih demo">{entries.map(p=><option value={p.id} selected={p.id===entry.id}>{p.data.title}</option>)}</select></label><div class="device-controls" role="group" aria-label="Ukuran perangkat"><button data-size="1440" aria-pressed="true">Desktop</button><button data-size="768" aria-pressed="false">Tablet</button><button data-size="390" aria-pressed="false">Mobile</button></div><div class="viewer-actions"><button id="reload-demo" aria-label="Muat ulang demo">↻</button><a id="open-demo" href={entry.data.livePath} target="_blank" rel="noopener noreferrer">Buka langsung ↗</a><a class="viewer-cta" href={`/kontak?demo=${entry.id}`}>Buat seperti ini →</a></div></header>
<main><div class="viewer-caption"><h1>{entry.data.title} / Konsep demo</h1><span id="frame-size">1440 × 900</span><span>Interaksi dapat dicoba</span></div><div id="viewer-stage"><div id="frame-holder"><iframe id="demo-frame" src={`${entry.data.livePath}?embed=1`} title={`Demo interaktif ${entry.data.title}`} width="1440" height="900" loading="eager"></iframe></div></div><p id="viewer-status" role="status">Memuat demo…</p><div id="viewer-error" hidden><p>Preview belum berhasil dimuat.</p><a href={entry.data.livePath}>Buka halaman demo langsung ↗</a></div><noscript><p>Gunakan <a href={entry.data.livePath}>halaman demo langsung</a> untuk ukuran layar yang nyaman.</p></noscript><a class="mobile-direct" href={entry.data.livePath}>Coba demo layar penuh ↗</a></main>
<style is:global>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#e7e9e2;color:#173c2d}a{color:inherit;text-decoration:none}button,select{font:inherit;color:inherit}button,a,select{touch-action:manipulation}button{cursor:pointer}button:focus-visible,a:focus-visible,select:focus-visible{outline:3px solid #547e20;outline-offset:4px}.viewer-toolbar{background:#f8f9f4;min-height:78px;padding:14px 24px;display:flex;align-items:center;gap:24px;border-bottom:1px solid #ced4c9;flex-wrap:wrap}.viewer-brand{font-size:36px;font-weight:800;letter-spacing:-5px;line-height:1}.viewer-brand span{color:#68883a;font-size:22px;vertical-align:top}.demo-choice{display:grid;gap:4px;min-width:180px}.demo-choice>span{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#667262}.demo-choice select{border:0;background:transparent;font-size:13px;max-width:220px}.device-controls{display:flex;border:1px solid #d5dbce;border-radius:8px;padding:4px;gap:3px;margin:auto}.device-controls button{border:0;padding:9px 12px;background:transparent;border-radius:4px;font-size:12px}.device-controls button[aria-pressed=true]{background:#163d2e;color:#f7f8f0}.viewer-actions{display:flex;align-items:center;gap:16px;font-size:12px}.viewer-actions button{background:none;border:1px solid #c4cebc;border-radius:50%;width:36px;height:36px;font-size:22px}.viewer-cta{background:#d7f876;padding:13px 18px;border-radius:5px;font-weight:700}main{padding:20px 24px 30px}.viewer-caption h1{font:inherit;margin:0;letter-spacing:inherit}.viewer-caption{display:flex;justify-content:space-between;font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin:0 auto 16px;max-width:1440px;color:#58664f}#viewer-stage{width:100%;height:auto;min-height:300px;overflow:hidden}#frame-holder{position:relative;margin:0 auto;box-shadow:0 15px 50px #172b2220;border-radius:8px;overflow:hidden;background:white}iframe{display:block;border:0;transform-origin:top left;background:white}#viewer-status{text-align:center;font-size:12px;margin:16px}#viewer-error{text-align:center;font-size:14px}#viewer-error a{text-decoration:underline}.mobile-direct{display:none}noscript{text-align:center}noscript a{text-decoration:underline}@media(max-width:1000px){.viewer-toolbar{gap:15px;padding:12px 16px}.viewer-actions{margin-left:auto}.device-controls{order:4;width:100%;justify-content:center}.viewer-caption span:last-child{display:none}}@media(max-width:600px){main{padding:16px 12px}.viewer-actions>a:not(.viewer-cta){display:none}.viewer-cta{padding:11px;font-size:10px}.demo-choice{min-width:0;flex:1}.demo-choice select{max-width:155px;font-size:12px}.viewer-brand{font-size:30px}.viewer-toolbar{gap:12px}.viewer-actions{gap:8px}.mobile-direct{display:block;text-align:center;background:#173c2d;color:white;padding:14px;border-radius:5px;font-size:13px;margin-top:18px}.viewer-caption{font-size:9px}}
</style>
<script>
const frame=document.querySelector<HTMLIFrameElement>('#demo-frame')!;const holder=document.querySelector<HTMLElement>('#frame-holder')!;const stage=document.querySelector<HTMLElement>('#viewer-stage')!;const label=document.querySelector('#frame-size')!;const status=document.querySelector<HTMLElement>('#viewer-status')!;const error=document.querySelector<HTMLElement>('#viewer-error')!;const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-size]')];let width=innerWidth<600?390:1440;let timer:ReturnType<typeof setTimeout>
const fit=()=>{const height=width===390?844:width===768?1024:900;const scale=Math.min(1,stage.clientWidth/width);frame.width=String(width);frame.height=String(height);frame.style.transform=`scale(${scale})`;holder.style.width=`${width*scale}px`;holder.style.height=`${height*scale}px`;label.textContent=`${width} × ${height}`;buttons.forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.size)===width)))}
const loading=()=>{status.textContent='Memuat demo…';error.hidden=true;clearTimeout(timer);timer=setTimeout(()=>{status.textContent='Demo membutuhkan waktu lebih lama.';error.hidden=false},12000)}
const loaded=()=>{try{if(!frame.contentDocument?.querySelector('#demo-main')){status.textContent='Preview tidak tersedia.';error.hidden=false;clearTimeout(timer);return}}catch{error.hidden=false}clearTimeout(timer);status.textContent='Demo siap dijelajahi. Semua aktivitas di dalamnya adalah simulasi.'}
buttons.forEach(b=>b.addEventListener('click',()=>{width=Number(b.dataset.size);fit()}));document.querySelector<HTMLSelectElement>('#demo-select')!.addEventListener('change',e=>{location.href=`/demo/preview/${(e.target as HTMLSelectElement).value}`});document.querySelector('#reload-demo')!.addEventListener('click',()=>{loading();frame.src=frame.src});frame.addEventListener('load',loaded);frame.addEventListener('error',()=>{clearTimeout(timer);error.hidden=false;status.textContent='Preview gagal dimuat.'});const observer=new ResizeObserver(fit);observer.observe(stage);fit();loading();if(frame.contentDocument?.readyState==='complete'&&frame.contentDocument.querySelector('#demo-main'))loaded();window.addEventListener('pagehide',()=>{observer.disconnect();clearTimeout(timer)},{once:true})
</script>
</body></html>
