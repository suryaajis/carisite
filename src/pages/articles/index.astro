---
import {getCollection} from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ArticleCard from '@/components/ui/ArticleCard.astro'
const articles=(await getCollection('articles')).sort((a,b)=>b.data.publishDate.getTime()-a.data.publishDate.getTime())
const categories=['Semua',...new Set(articles.map(a=>a.data.category))]
---
<BaseLayout title="Jurnal — Ide, Website & Bisnis | Carisite" description="Catatan praktis tentang merencanakan website, memahami biaya, dan memilih solusi digital yang sesuai kebutuhan bisnis."><section class="page-hero"><div class="container"><span class="eyebrow">The journal / Notes from the atelier</span><h1>Ide yang dibagikan.<br/><em>Langkah yang lebih jelas.</em></h1><p>Catatan tentang website, bisnis, dan keputusan kecil yang membantu Anda memulai dengan lebih siap.</p></div></section><section class="section"><div class="container"><div class="article-filters" role="group" aria-label="Kategori artikel">{categories.map((c,i)=><button type="button" data-article-filter={c} aria-pressed={i===0}>{c}</button>)}</div><p id="article-count" role="status">{articles.length} artikel untuk dibaca</p><div class="insights-grid">{articles.map(entry=><ArticleCard entry={entry}/>)}</div></div></section></BaseLayout>
<style>.article-filters{display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:1.5rem}.article-filters button{border:1px solid var(--line);border-radius:99px;padding:.7rem 1.2rem;font-size:.8rem}.article-filters button[aria-pressed=true]{background:var(--forest);color:var(--paper)}#article-count{font-size:.75rem;color:var(--muted);margin-bottom:2rem}.insights-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem 2.5rem}@media(max-width:650px){.insights-grid{grid-template-columns:1fr;gap:3rem}}</style>
<script>
const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-article-filter]')];filters.forEach(b=>b.addEventListener('click',()=>{let count=0;filters.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.querySelectorAll<HTMLElement>('[data-article-category]').forEach(card=>{card.hidden=b.dataset.articleFilter!=='Semua'&&card.dataset.articleCategory!==b.dataset.articleFilter;if(!card.hidden)count++});document.querySelector('#article-count')!.textContent=`${count} artikel untuk dibaca`}))
</script>
