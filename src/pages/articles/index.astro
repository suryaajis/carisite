---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Badge from '@/components/ui/Badge.astro'
import SectionLabel from '@/components/ui/SectionLabel.astro'

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
)

const categories = ['Semua', ...new Set(articles.map((a) => a.data.category))]
---

<BaseLayout
  title="Artikel & Tips Bisnis — Carisite"
  description="Kumpulan artikel, tips, dan inspirasi bisnis untuk membantu UMKM Indonesia tumbuh di era digital."
>
  <section class="bg-surface">
    <div class="mx-auto max-w-container px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <SectionLabel label="Artikel" />
      <h1 class="mt-4 text-center text-3xl font-extrabold text-ink sm:text-4xl">
        Wawasan & Inspirasi Bisnis
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-center text-ink-muted">
        Tips dan informasi praktis untuk membantu UMKM Anda tumbuh di era
        digital.
      </p>

      <!-- Category filter -->
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        {
          categories.map((cat, i) => (
            <button
              data-filter={cat}
              class:list={[
                'rounded-full border px-4 py-1.5 text-sm font-medium transition',
                i === 0
                  ? 'border-primary bg-primary text-white'
                  : 'border-outline-variant bg-surface-lowest text-ink-muted hover:border-primary hover:text-primary-deep',
              ]}
            >
              {cat}
            </button>
          ))
        }
      </div>

      <div id="article-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((article) => (
            <article
              data-category={article.data.category}
              class="group overflow-hidden rounded-xl border border-outline-variant bg-surface-lowest shadow-soft transition-shadow hover:shadow-card"
            >
              <a href={`/articles/${article.slug}`} class="block overflow-hidden">
                <img
                  src={article.data.image}
                  alt={article.data.title}
                  width="800"
                  height="500"
                  loading="lazy"
                  class="aspect-[8/5] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
              </a>
              <div class="p-6">
                <Badge label={article.data.category} />
                <h2 class="mt-3 font-heading text-lg font-bold text-ink">
                  <a href={`/articles/${article.slug}`} class="hover:text-primary-deep">
                    {article.data.title}
                  </a>
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                  {article.data.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]')
  const cards = document.querySelectorAll<HTMLElement>('#article-grid [data-category]')

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter

      buttons.forEach((b) => {
        const active = b === btn
        b.classList.toggle('bg-primary', active)
        b.classList.toggle('text-white', active)
        b.classList.toggle('border-primary', active)
        b.classList.toggle('bg-surface-lowest', !active)
        b.classList.toggle('text-ink-muted', !active)
        b.classList.toggle('border-outline-variant', !active)
      })

      cards.forEach((card) => {
        const show = filter === 'Semua' || card.dataset.category === filter
        card.classList.toggle('hidden', !show)
      })
    })
  })
</script>
